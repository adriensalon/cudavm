DRIVER_API(cuLibraryLoadData, (CUlibrary* output, const void* image, CUjit_option* options, void** values, unsigned count, CUlibraryOption* library_options, void** library_values, unsigned library_count),
    driver_ready(); require(output && image, CUDA_ERROR_INVALID_VALUE, "null library image or output"); *output = library_load(image, nullptr, options, values, count, library_options, library_values, library_count))
DRIVER_API(cuLibraryLoadFromFile, (CUlibrary* output, const char* path, CUjit_option* options, void** values, unsigned count, CUlibraryOption* library_options, void** library_values, unsigned library_count),
    driver_ready(); require(output && path && *path, CUDA_ERROR_INVALID_VALUE, "null library file or output"); *output = library_load(nullptr, path, options, values, count, library_options, library_values, library_count))
DRIVER_API(cuLibraryUnload, (CUlibrary handle), driver_ready(); library_unload(handle))
DRIVER_API(cuLibraryGetKernel, (CUkernel* output, CUlibrary handle, const char* name), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null library kernel output"); *output = library_find(handle, name))
DRIVER_API(cuLibraryGetModule, (CUmodule* output, CUlibrary handle), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null library module output"); *output = library_bind(handle, current()))
DRIVER_API(cuKernelGetFunction, (CUfunction* output, CUkernel kernel), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null kernel function output"); library_kernel_lookup(kernel); *output = resolve_library_function(reinterpret_cast<CUfunction>(kernel), current()))
DRIVER_API(cuKernelGetLibrary, (CUlibrary* output, CUkernel kernel), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null kernel library output"); *output = library_kernel_lookup(kernel)->library)
DRIVER_API(cuKernelGetName, (const char** output, CUkernel kernel), driver_ready(); require(output && kernel, CUDA_ERROR_INVALID_VALUE, "null kernel name output"); *output = library_kernel_lookup(kernel)->name.c_str())
DRIVER_API(cuLibraryGetKernelCount, (unsigned* output, CUlibrary handle), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null library count output"); *output = unsigned(library_names(handle).size()))
DRIVER_API(cuLibraryEnumerateKernels, (CUkernel* output, unsigned capacity, CUlibrary handle), driver_ready();
    auto names = library_names(handle); require(output || !capacity, CUDA_ERROR_INVALID_VALUE, "null library kernel array");
    names.resize(std::min<size_t>(capacity, names.size())); std::vector<CUkernel> result; for (auto& name : names) result.push_back(library_find(handle, name.c_str())); std::copy(result.begin(), result.end(), output))
DRIVER_API(cuKernelGetParamCount, (CUkernel kernel, size_t* output), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null kernel parameter count output"); *output = library_parameters(kernel).size())
DRIVER_API(cuKernelGetParamInfo, (CUkernel kernel, size_t index, size_t* offset, size_t* size), driver_ready(); require(offset, CUDA_ERROR_INVALID_VALUE, "null kernel parameter offset output"); auto layout = library_parameters(kernel); require(index < layout.size(), CUDA_ERROR_INVALID_VALUE, "kernel parameter index out of range"); *offset = layout[index].offset; if (size) *size = layout[index].size)
DRIVER_API(cuKernelGetAttribute, (int* output, CUfunction_attribute attribute, CUkernel kernel, CUdevice device), driver_ready();
    require(output && attribute >= 0 && attribute < CU_FUNC_ATTRIBUTE_MAX, CUDA_ERROR_INVALID_VALUE, "invalid library attribute query"); *output = library_attribute(kernel, attribute, device))
DRIVER_API(cuKernelSetAttribute, (CUfunction_attribute attribute, int value, CUkernel kernel, CUdevice device), driver_ready();
    require(attribute >= CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES && attribute < CU_FUNC_ATTRIBUTE_MAX && attribute != CU_FUNC_ATTRIBUTE_DEVICE_NODE_UPDATE_SUPPORTED, CUDA_ERROR_INVALID_VALUE, "kernel attribute is not writable");
    library_configure(kernel, attribute, value, device))
DRIVER_API(cuKernelSetCacheConfig, (CUkernel kernel, CUfunc_cache config, CUdevice device), driver_ready(); require(config >= CU_FUNC_CACHE_PREFER_NONE && config <= CU_FUNC_CACHE_PREFER_EQUAL, CUDA_ERROR_INVALID_VALUE, "invalid kernel cache preference"); library_configure(kernel, CU_FUNC_ATTRIBUTE_MAX, int(config), device, true))
DRIVER_API(cuLibraryGetGlobal, (CUdeviceptr* output, size_t* bytes, CUlibrary handle, const char* name), driver_ready(); require(output || bytes, CUDA_ERROR_INVALID_VALUE, "missing library global output"); auto owner = current(); auto symbol = find_global(library_bind(handle, owner), name, owner); if (output) *output = symbol.address; if (bytes) *bytes = symbol.bytes)
DRIVER_API(cuLibraryGetManaged, (CUdeviceptr* output, size_t* bytes, CUlibrary handle, const char* name), driver_ready(); require((output || bytes) && name && *name, CUDA_ERROR_INVALID_VALUE, "invalid managed symbol query"); auto symbol = library_managed(handle, name); if (output) *output = symbol.address; if (bytes) *bytes = symbol.bytes)
DRIVER_API(cuLibraryGetUnifiedFunction, (void** output, CUlibrary handle, const char* name), driver_ready(); require(output && name && *name, CUDA_ERROR_INVALID_VALUE, "invalid unified function query"); auto entry = library_lookup(handle); require(bool(entry->native), CUDA_ERROR_NOT_SUPPORTED, "native unified functions are unavailable on this adapter"); *output = entry->native->unified_function(name))
DRIVER_API(cuModuleGetFunctionCount, (unsigned* output, CUmodule handle), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null module count output"); *output = unsigned(module_lookup(handle, current()).native->kernel_names().size()))
DRIVER_API(cuModuleEnumerateFunctions, (CUfunction* output, unsigned capacity, CUmodule handle), driver_ready(); auto owner = current(); auto names = module_lookup(handle, owner).native->kernel_names();
    require(output || !capacity, CUDA_ERROR_INVALID_VALUE, "null module function array"); names.resize(std::min<size_t>(capacity, names.size())); std::vector<CUfunction> functions; for (auto& name : names) functions.push_back(find_function(handle, name.c_str(), owner)); std::copy(functions.begin(), functions.end(), output))
DRIVER_API(cuModuleGetLoadingMode, (CUmoduleLoadingMode* output), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null module loading mode output"); *output = global().provider->loading_mode())
