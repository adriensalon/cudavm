DRIVER_API(cuStreamCreate, (CUstream* output, unsigned flags), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null stream output"); *output = create_stream(flags, 0))
DRIVER_API(cuStreamCreateWithPriority, (CUstream* output, unsigned flags, int priority), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null stream output"); *output = create_stream(flags, priority))
DRIVER_API(cuCtxGetStreamPriorityRange, (int* least, int* greatest), driver_ready(); auto range = current()->priority_range; if (least) *least = range.first; if (greatest) *greatest = range.second)
DRIVER_API(cuStreamGetPriority, (CUstream handle, int* priority), driver_ready(); require(priority, CUDA_ERROR_INVALID_VALUE, "null stream priority output"); auto stream = stream_lookup(handle); *priority = stream->attributes.priority.value_or(stream->priority))
DRIVER_API(cuStreamGetPriority_ptsz, (CUstream handle, int* priority), driver_ready(); require(priority, CUDA_ERROR_INVALID_VALUE, "null stream priority output"); auto stream = stream_lookup(handle ? handle : CU_STREAM_PER_THREAD); *priority = stream->attributes.priority.value_or(stream->priority))
DRIVER_API(cuStreamGetFlags, (CUstream handle, unsigned* flags), driver_ready(); require(flags, CUDA_ERROR_INVALID_VALUE, "null stream flags output"); *flags = stream_lookup(handle)->flags)
DRIVER_API(cuStreamGetAttribute, (CUstream handle, CUstreamAttrID attribute, CUstreamAttrValue* output), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null stream attribute output"); *output = stream_attribute(stream_lookup(handle), attribute))
DRIVER_API(cuStreamSetAttribute, (CUstream handle, CUstreamAttrID attribute, const CUstreamAttrValue* value), driver_ready(); require(value, CUDA_ERROR_INVALID_VALUE, "null stream attribute value"); stream_attribute(stream_lookup(handle), attribute, *value))
DRIVER_API(cuStreamCopyAttributes, (CUstream destination, CUstream source), driver_ready(); copy_stream_attributes(destination, source))
DRIVER_API(cuStreamGetId, (CUstream handle, unsigned long long* id), driver_ready(); require(id, CUDA_ERROR_INVALID_VALUE, "null stream identity output"); *id = stream_lookup(handle)->id)
DRIVER_API(cuStreamGetDevice, (CUstream handle, CUdevice* device), driver_ready(); require(device, CUDA_ERROR_INVALID_VALUE, "null stream device output"); *device = stream_lookup(handle)->owner.lock()->device)
DRIVER_API(cuStreamGetCtx, (CUstream handle, CUcontext* output), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null stream context output"); *output = stream_lookup(handle)->owner.lock()->handle)
DRIVER_API(cuStreamGetCtx_v2, (CUstream handle, CUcontext* output, CUgreenCtx* green), driver_ready(); require(output || green, CUDA_ERROR_INVALID_VALUE, "missing stream context outputs"); auto owner = stream_lookup(handle)->owner.lock(); if (output) *output = owner->handle; if (green) *green = nullptr)
DRIVER_API(cuStreamQuery, (CUstream handle), driver_ready(); stream_status(handle, false))
DRIVER_API(cuStreamSynchronize, (CUstream handle), driver_ready(); stream_status(handle, true))
DRIVER_API(cuStreamDestroy, (CUstream handle), driver_ready(); require(handle && handle != CU_STREAM_LEGACY && handle != CU_STREAM_PER_THREAD, CUDA_ERROR_INVALID_HANDLE, "cannot destroy an implicit stream");
    auto stream = stream_lookup(handle); if (stream->capture) capture_fail(stream->capture, CUDA_ERROR_STREAM_CAPTURE_UNSUPPORTED, "cannot destroy a capturing stream"); global().streams.erase(handle))
DRIVER_API(cuStreamWaitEvent, (CUstream stream, CUevent event, unsigned flags), driver_ready(); wait_event(stream, event, flags))
DRIVER_API(cuEventCreate, (CUevent* output, unsigned flags), driver_ready(); require(output, CUDA_ERROR_INVALID_VALUE, "null event output"); *output = create_event(flags))
DRIVER_API(cuEventRecord, (CUevent event, CUstream stream), driver_ready(); record_event(event, stream, 0))
DRIVER_API(cuEventRecordWithFlags, (CUevent event, CUstream stream, unsigned flags), driver_ready(); record_event(event, stream, flags))
DRIVER_API(cuEventQuery, (CUevent event), driver_ready(); event_status(event, false))
DRIVER_API(cuEventSynchronize, (CUevent event), driver_ready(); event_status(event, true))
DRIVER_API(cuEventDestroy, (CUevent event), driver_ready(); event_lookup(event); global().events.erase(event))
DRIVER_API(cuEventElapsedTime, (float* output, CUevent start, CUevent end), driver_ready(); event_elapsed(output, start, end))
DRIVER_API(cuLaunchHostFunc, (CUstream stream, CUhostFn function, void* data), driver_ready(); host_function(stream, function, data))
DRIVER_API(cuStreamAddCallback, (CUstream stream, CUstreamCallback callback, void* data, unsigned flags), driver_ready(); stream_callback(stream, stream, callback, data, flags))
DRIVER_API(cuStreamAddCallback_ptsz, (CUstream stream, CUstreamCallback callback, void* data, unsigned flags), driver_ready(); stream_callback(stream ? stream : CU_STREAM_PER_THREAD, stream, callback, data, flags))
