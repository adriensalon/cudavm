+  [[nodiscard]] bool lowerResourceAtomicBinOp(Function &F) {
+    IRBuilder<> &IRB = OpBuilder.getIRB();
+    Type *Int32Ty = IRB.getInt32Ty();
+    return replaceFunction(F, [&](CallInst *CI) -> Error {
+      IRB.SetInsertPoint(CI);
+      Value *Handle =
+          createTmpHandleCast(CI->getArgOperand(0), OpBuilder.getHandleType());
+      Value *Offset = CI->getArgOperand(3);
+      if (isa<PoisonValue>(Offset))
+        Offset = UndefValue::get(Int32Ty);
+      Value *Undef = UndefValue::get(Int32Ty);
+      Expected<CallInst *> OpCall = OpBuilder.tryCreateOp(
+          OpCode::AtomicBinOp,
+          {Handle, CI->getArgOperand(1), CI->getArgOperand(2), Offset, Undef,
+           CI->getArgOperand(4)},
+          CI->getName(), Int32Ty);
+      if (Error E = OpCall.takeError())
+        return E;
+      CI->replaceAllUsesWith(*OpCall);
+      CI->eraseFromParent();
+      return Error::success();
+    });
+  }
