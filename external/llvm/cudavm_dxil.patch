diff --git a/llvm/lib/Target/DirectX/DXILResourceAccess.cpp b/llvm/lib/Target/DirectX/DXILResourceAccess.cpp
index 3d75d7455101f4b898b0c259ad1f6f1c25b734dd..4b36af210051aef27494848e4e4deef1f4721e50 100644
--- a/llvm/lib/Target/DirectX/DXILResourceAccess.cpp
+++ b/llvm/lib/Target/DirectX/DXILResourceAccess.cpp
@@ -85,6 +85,166 @@ static Value *traverseGEPOffsets(const DataLayout &DL, IRBuilder<> &Builder,
   llvm_unreachable("GEP of null pointer?");
 }
 
+struct ResourceAtomicAddress {
+  Value *Index;
+  Value *Offset;
+};
+
+static ResourceAtomicAddress
+getResourceAtomicAddress(IntrinsicInst *II, Instruction *Access,
+                         Value *Pointer,
+                         dxil::ResourceTypeInfo &RTI) {
+  const DataLayout &DL = Access->getDataLayout();
+  IRBuilder<> Builder(Access);
+  Value *Index = II->getOperand(1);
+  Value *Offset = traverseGEPOffsets(DL, Builder, Pointer, 1);
+  if (!RTI.isStruct()) {
+    auto *ConstantOffset = dyn_cast<ConstantInt>(Offset);
+    if (!ConstantOffset || !ConstantOffset->isZero())
+      Index = Builder.CreateAdd(Index, Offset);
+    Offset = PoisonValue::get(Builder.getInt32Ty());
+  }
+  return {Index, Offset};
+}
+
+static bool hasAcquireSemantics(AtomicOrdering Ordering) {
+  return Ordering == AtomicOrdering::Acquire ||
+         Ordering == AtomicOrdering::AcquireRelease ||
+         Ordering == AtomicOrdering::SequentiallyConsistent;
+}
+
+static bool hasReleaseSemantics(AtomicOrdering Ordering) {
+  return Ordering == AtomicOrdering::Release ||
+         Ordering == AtomicOrdering::AcquireRelease ||
+         Ordering == AtomicOrdering::SequentiallyConsistent;
+}
+
+static void createDeviceMemoryBarrier(IRBuilder<> &Builder) {
+  Builder.CreateIntrinsic(Intrinsic::dx_device_memory_barrier, {});
+}
+
+static std::pair<unsigned, Value *>
+getDXILAtomicBinOp(IRBuilder<> &Builder, AtomicRMWInst &RMW) {
+  Value *ValueOperand = RMW.getValOperand();
+  switch (RMW.getOperation()) {
+  case AtomicRMWInst::Xchg:
+    return {8, ValueOperand};
+  case AtomicRMWInst::Add:
+    return {0, ValueOperand};
+  case AtomicRMWInst::Sub:
+    return {0, Builder.CreateNeg(ValueOperand)};
+  case AtomicRMWInst::And:
+    return {1, ValueOperand};
+  case AtomicRMWInst::Or:
+    return {2, ValueOperand};
+  case AtomicRMWInst::Xor:
+    return {3, ValueOperand};
+  case AtomicRMWInst::Min:
+    return {4, ValueOperand};
+  case AtomicRMWInst::Max:
+    return {5, ValueOperand};
+  case AtomicRMWInst::UMin:
+    return {6, ValueOperand};
+  case AtomicRMWInst::UMax:
+    return {7, ValueOperand};
+  default:
+    llvm_unreachable("Unsupported DXIL resource atomic operation");
+  }
+}
+
+static CallInst *createResourceAtomicBinOp(IntrinsicInst *II,
+                                           Instruction *Access,
+                                           Value *Pointer, Value *ValueOperand,
+                                           unsigned Operation,
+                                           dxil::ResourceTypeInfo &RTI) {
+  IRBuilder<> Builder(Access);
+  ResourceAtomicAddress Address =
+      getResourceAtomicAddress(II, Access, Pointer, RTI);
+  auto *Call = Builder.CreateIntrinsic(
+      Intrinsic::dx_resource_atomic_binop_i32,
+      {II->getOperand(0)->getType()},
+      {II->getOperand(0), Builder.getInt32(Operation), Address.Index,
+       Address.Offset, ValueOperand});
+  Call->copyMetadata(*Access);
+  return Call;
+}
+
+static void createAtomicLoad(IntrinsicInst *II, LoadInst *LI,
+                             dxil::ResourceTypeInfo &RTI) {
+  assert(LI->getType()->isIntegerTy(32) &&
+         "DXIL resource atomic loads require i32");
+  IRBuilder<> Builder(LI);
+  Value *Result = createResourceAtomicBinOp(
+      II, LI, LI->getPointerOperand(), Builder.getInt32(0), 2, RTI);
+  if (hasAcquireSemantics(LI->getOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  LI->replaceAllUsesWith(Result);
+}
+
+static void createAtomicStore(IntrinsicInst *II, StoreInst *SI,
+                              dxil::ResourceTypeInfo &RTI) {
+  assert(SI->getValueOperand()->getType()->isIntegerTy(32) &&
+         "DXIL resource atomic stores require i32");
+  IRBuilder<> Builder(SI);
+  if (hasReleaseSemantics(SI->getOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  (void)createResourceAtomicBinOp(II, SI, SI->getPointerOperand(),
+                                  SI->getValueOperand(), 8, RTI);
+  if (SI->getOrdering() == AtomicOrdering::SequentiallyConsistent)
+    createDeviceMemoryBarrier(Builder);
+}
+
+static void createAtomicRMW(IntrinsicInst *II, AtomicRMWInst *RMW,
+                            dxil::ResourceTypeInfo &RTI) {
+  assert(RMW->getType()->isIntegerTy(32) &&
+         "DXIL resource atomic RMW requires i32");
+  IRBuilder<> Builder(RMW);
+  if (hasReleaseSemantics(RMW->getOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  auto [Operation, ValueOperand] = getDXILAtomicBinOp(Builder, *RMW);
+  Value *Result = createResourceAtomicBinOp(
+      II, RMW, RMW->getPointerOperand(), ValueOperand, Operation, RTI);
+  if (hasAcquireSemantics(RMW->getOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  RMW->replaceAllUsesWith(Result);
+}
+
+static void createAtomicCmpXchg(IntrinsicInst *II, AtomicCmpXchgInst *CmpXchg,
+                                dxil::ResourceTypeInfo &RTI) {
+  assert(CmpXchg->getCompareOperand()->getType()->isIntegerTy(32) &&
+         "DXIL resource compare-exchange requires i32");
+  IRBuilder<> Builder(CmpXchg);
+  if (hasReleaseSemantics(CmpXchg->getSuccessOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  ResourceAtomicAddress Address = getResourceAtomicAddress(
+      II, CmpXchg, CmpXchg->getPointerOperand(), RTI);
+  auto *Previous = Builder.CreateIntrinsic(
+      Intrinsic::dx_resource_atomic_cmpxchg_i32,
+      {II->getOperand(0)->getType()},
+      {II->getOperand(0), Address.Index, Address.Offset,
+       CmpXchg->getCompareOperand(), CmpXchg->getNewValOperand()});
+  Previous->copyMetadata(*CmpXchg);
+  if (hasAcquireSemantics(CmpXchg->getSuccessOrdering()) ||
+      hasAcquireSemantics(CmpXchg->getFailureOrdering()))
+    createDeviceMemoryBarrier(Builder);
+  Value *Succeeded =
+      Builder.CreateICmpEQ(Previous, CmpXchg->getCompareOperand());
+  SmallVector<ExtractValueInst *> Extracts;
+  for (User *User : CmpXchg->users()) {
+    auto *Extract = dyn_cast<ExtractValueInst>(User);
+    assert(Extract && Extract->getNumIndices() == 1 &&
+           Extract->getIndices()[0] < 2 &&
+           "Unsupported use of resource compare-exchange result");
+    Extracts.push_back(Extract);
+  }
+  for (ExtractValueInst *Extract : Extracts) {
+    Extract->replaceAllUsesWith(Extract->getIndices()[0] == 0
+                                    ? static_cast<Value *>(Previous)
+                                    : Succeeded);
+    Extract->eraseFromParent();
+  }
+}
