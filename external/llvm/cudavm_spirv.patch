+// RegToMem may spill scalar/vector state, but never an SSA pointer. Logical
+// Vulkan shaders cannot store a StorageBuffer pointer in Function storage
+// without VariablePointersStorageBuffer, and CUDAVM deliberately does not enable
+// that capability. Diagnose this at the pass boundary rather than in spirv-val.
+class CUDAVMRegToMemPointerContractPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMRegToMemPointerContractPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM RegToMem pointer-spill contract";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *AI = dyn_cast<AllocaInst>(&I);
+        if (!AI || !AI->getAllocatedType()->isPointerTy())
+          continue;
+
+        // RegToMem names its synthetic stack slots with a reg2mem stem. Do not
+        // reject source-language pointer objects here; CUDAVM's earlier pointer
+        // lowering owns those semantics.
+        if (!AI->getName().contains("reg2mem"))
+          continue;
+
+        std::string Text;
+        raw_string_ostream OS(Text);
+        AI->print(OS);
+        OS.flush();
+        report_fatal_error(
+            Twine("CUDAVM RegToMem attempted to spill a pointer in function '") +
+            F.getName() + ":\n  alloca: " + Text);
+      }
+    }
+    return false;
+  }
+};
