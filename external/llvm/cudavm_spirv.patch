+static CUDAVMIrreducibleSummary cudavmSummarizeIrreducibleCFG(Function &F) {
+  CUDAVMIrreducibleSummary Summary;
+  DomTreeBuilder::BBDomTree DT;
+  DT.recalculate(F);
