+    const std::vector<BasicBlock *> &SCC = *I;
+    bool Cyclic = SCC.size() > 1;
+    if (!Cyclic && !SCC.empty()) {
+      for (BasicBlock *Succ : successors(SCC.front()))
+        Cyclic |= Succ == SCC.front();
+    }
+    if (!Cyclic)
+      continue;
