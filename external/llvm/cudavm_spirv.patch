+char CUDAVMNativeStructuredCFGContractPass::ID = 0;
+
+// LLVM's native region/structurizer passes may create fresh cross-block SSA after
+// the first RegToMem, and LLVM 22's region-exit merger can even transiently
+// produce invalid dominance on CFGs synthesized by CUDAVM recursion lowering.
+// Mark such functions before native structurization so they take the bounded
+// fallback instead of feeding malformed SSA farther into the target pipeline.
+class CUDAVMPreNativeIRFallbackPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMPreNativeIRFallbackPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM pre-native SPIR-V IR validity boundary";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    raw_null_ostream NullOS;
+    if (!verifyFunction(F, &NullOS))
+      return false;
+
+    F.addFnAttr(CUDAVMDispatchFallbackAttr);
+    F.addFnAttr(CUDAVMStructurizationStrategyAttr,
+                "dispatcher-fallback-region-invalid");
+    errs() << "cudavm: SPIR-V native-structure fallback function="
+           << F.getName() << " reason=invalid-ir-after-region-exit-merge\n";
+    return true;
+  }
+};
+
+char CUDAVMPreNativeIRFallbackPass::ID = 0;
+
+static bool cudavmFallbackValueEscapes(const Instruction &Inst) {
+  if (!Inst.getType()->isSized())
+    return false;
+
+  const BasicBlock *BB = Inst.getParent();
+  for (const User *U : Inst.users()) {
+    const auto *UI = cast<Instruction>(U);
+    if (UI->getParent() != BB || isa<PHINode>(UI))
+      return true;
+  }
+  return false;
+}
+
+// The canonical dispatcher assumes the RegToMem invariant: no ordinary SSA
+// value is live across executable states. Native structurization can introduce
+// new cross-block scalar SSA after the first RegToMem, so a late fallback must
+// re-establish that invariant before it starts rewiring predecessors. Doing
+// this only on fallback-marked functions preserves compact SSA on the native
+// path. Pointer state is deliberately rejected: logical SPIR-V pointer values
+// may never be hidden in Function-storage spill slots.
+class CUDAVMLateDispatcherStateNormalizationPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMLateDispatcherStateNormalizationPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM late dispatcher RegToMem normalization";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || !F.hasFnAttribute(CUDAVMDispatchFallbackAttr) ||
+        F.hasFnAttribute(CUDAVMDispatchAppliedAttr))
+      return false;
+
+    BasicBlock &Entry = F.getEntryBlock();
+    auto AllocaPoint = Entry.begin();
+    while (AllocaPoint != Entry.end() && isa<AllocaInst>(*AllocaPoint))
+      ++AllocaPoint;
+    if (AllocaPoint == Entry.end())
+      report_fatal_error(
+          Twine("CUDAVM late dispatcher normalization found unterminated entry in function '") +
+          F.getName() + "'");
+
+    SmallVector<Instruction *, 64> Escaped;
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        if (isa<PHINode>(I))
+          continue;
+        if (isa<AllocaInst>(I) && &BB == &Entry)
+          continue;
+        if (!cudavmFallbackValueEscapes(I))
+          continue;
+        if (I.getType()->isPointerTy())
+          report_fatal_error(
+              Twine("CUDAVM late dispatcher normalization would spill pointer SSA in function '") +
+              F.getName() + "'");
+        Escaped.push_back(&I);
+      }
+    }
+
+    // Match RegToMem's reverse work-list order so demoting a producer cannot
+    // invalidate a later work-list element before it is processed.
+    for (auto It = Escaped.rbegin(), End = Escaped.rend(); It != End; ++It)
+      DemoteRegToStack(**It, false, AllocaPoint);
+
+    SmallVector<PHINode *, 32> Phis;
+    for (BasicBlock &BB : F)
+      for (PHINode &Phi : BB.phis()) {
+        if (Phi.getType()->isPointerTy())
+          report_fatal_error(
+              Twine("CUDAVM late dispatcher normalization observed pointer PHI in function '") +
+              F.getName() + "'");
+        Phis.push_back(&Phi);
+      }
+    for (PHINode *Phi : Phis)
+      DemotePHIToStack(Phi, AllocaPoint);
+
+    std::string VerifyDiagnostic;
+    raw_string_ostream VerifyOutput(VerifyDiagnostic);
+    if (verifyFunction(F, &VerifyOutput)) {
+      VerifyOutput.flush();
+      report_fatal_error(
+          Twine("CUDAVM late dispatcher normalization failed to restore valid SSA in function '") +
+          F.getName() + ":\n" + VerifyDiagnostic);
+    }
+
+    if (!Escaped.empty() || !Phis.empty())
+      errs() << "cudavm: SPIR-V late dispatcher normalization function="
+             << F.getName() << " escaped=" << Escaped.size()
+             << " phis=" << Phis.size() << "\n";
+    return !Escaped.empty() || !Phis.empty();
+  }
+};
+
+char CUDAVMLateDispatcherStateNormalizationPass::ID = 0;
+
+// RegToMem has already removed PHIs and ordinary values spanning basic blocks.
+// Keep its existing entry/allocation block as a permanent prologue, and map
+// each executable basic block to one scalar state. The only cyclic CFG is then
+// one natural loop containing one switch. Unlike LLVM's generic structurizer,
+// we know the exact loop/selection nesting while constructing it, so emit the
+// target merge intrinsics here instead of rediscovering the constructs later.
+class CUDAVMCanonicalDispatchCFGPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMCanonicalDispatchCFGPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM bounded SPIR-V dispatcher fallback";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || !F.hasFnAttribute(CUDAVMDispatchFallbackAttr) ||
+        F.hasFnAttribute(CUDAVMDispatchAppliedAttr))
+      return false;
+
+    // A late fallback may be selected after LLVM's native structurizer has
+    // already inserted merge intrinsics and split/proxy blocks. The CFG edits
+    // are semantics-preserving and can be flattened, but those merge markers
+    // describe the old construct tree and must not survive into the canonical
+    // dispatcher.
+    SmallVector<Instruction *, 32> OldMergeIntrinsics;
+    for (BasicBlock &BB : F)
+      for (Instruction &I : BB)
+        if (auto *II = dyn_cast<IntrinsicInst>(&I);
+            II && (II->getIntrinsicID() == Intrinsic::spv_loop_merge ||
+                   II->getIntrinsicID() == Intrinsic::spv_selection_merge))
+          OldMergeIntrinsics.push_back(II);
+    for (Instruction *I : OldMergeIntrinsics)
+      I->eraseFromParent();
+
+    removeUnreachableBlocks(F);
+
+    // A terminal single-block function contains no structured construct.
+    if (F.size() == 1) {
+      Instruction *T = F.getEntryBlock().getTerminator();
+      if (isa<ReturnInst>(T) || isa<UnreachableInst>(T))
+        return false;
+    }
+
+    BasicBlock *Entry = &F.getEntryBlock();
+
+    // The dispatcher deliberately destroys the original dominance relation
+    // between executable states. Storage declarations whose pointer is used by
+    // later states must therefore live in the permanent prologue. This is the
+    // same target-side normalization used by GPU backends such as NVPTX:
+    // constant-size allocas can be hoisted to function entry without needing a
+    // runtime stack-state representation. Dynamic/inalloca storage is a
+    // different semantic feature and must be lowered explicitly rather than
+    // hidden by this CFG transform.
+    SmallVector<AllocaInst *, 32> Allocas;
+    for (BasicBlock &BB : F)
+      for (Instruction &I : BB)
+        if (auto *AI = dyn_cast<AllocaInst>(&I))
+          Allocas.push_back(AI);
+
+    Instruction *AllocaAnchor = &*Entry->getFirstInsertionPt();
+    for (AllocaInst *AI : Allocas) {
+      if (!isa<ConstantInt>(AI->getArraySize()) || AI->isUsedWithInAlloca() ||
+          AI->isSwiftError())
+        report_fatal_error(
+            Twine("CUDAVM canonical SPIR-V dispatcher requires explicit lowering for dynamic/special alloca in function '") +
+            F.getName() + "'");
+      if (AI != AllocaAnchor)
+        AI->moveBefore(AllocaAnchor->getIterator());
+    }
+
+    auto FirstBody = Entry->begin();
+    while (FirstBody != Entry->end() && isa<AllocaInst>(*FirstBody))
+      ++FirstBody;
+    if (FirstBody == Entry->end())
+      report_fatal_error(
+          Twine("CUDAVM SPIR-V dispatcher found unterminated entry in function '") +
+          F.getName() + "'");
+
+    // Splitting here preserves all RegToMem and source allocas in the real
+    // entry, so their original function-wide dominance remains true.
+    BasicBlock *InitialBody = Entry->splitBasicBlock(
+        FirstBody, "cudavm.spirv.dispatch.initial");
+
+    // Capture only original executable blocks before creating dispatcher
+    // infrastructure. Each appears exactly once in the final CFG.
+    SmallVector<BasicBlock *, 64> Blocks;
+    DenseMap<BasicBlock *, unsigned> StateFor;
+    Blocks.reserve(F.size() - 1);
+    for (BasicBlock &BB : F) {
+      if (&BB == Entry)
+        continue;
+      for (Instruction &I : BB) {
+        if (isa<PHINode>(I))
+          report_fatal_error(
+              Twine("CUDAVM SPIR-V dispatcher observed PHI after RegToMem in function '") +
+              F.getName() + "'");
+      }
+      if (Blocks.size() >= std::numeric_limits<unsigned>::max())
+        report_fatal_error("CUDAVM SPIR-V dispatcher state space overflow");
+      const unsigned State = static_cast<unsigned>(Blocks.size());
+      Blocks.push_back(&BB);
+      StateFor[&BB] = State;
+    }
+
+    auto StateForTarget = [&](BasicBlock *Target) -> unsigned {
+      // The executable suffix of the old entry moved to InitialBody. Any
+      // original back-edge to Entry must resume there, never in the prologue.
+      if (Target == Entry)
+        Target = InitialBody;
+      auto It = StateFor.find(Target);
+      if (It == StateFor.end())
+        report_fatal_error(
+            Twine("CUDAVM SPIR-V dispatcher target is outside the state space in function '") +
+            F.getName() + "'");
+      return It->second;
+    };
+
+    LLVMContext &Ctx = F.getContext();
+
+    // Header blocks must precede the original body. Exit/merge blocks are
+    // appended after all state blocks, yielding the natural structured order.
+    BasicBlock *LoopHeader =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.loop", &F, InitialBody);
+    BasicBlock *SwitchHeader =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.switch", &F, InitialBody);
+    constexpr unsigned MaxDispatchCases = 64;
+    const unsigned ChunkCount = static_cast<unsigned>(
+        (Blocks.size() + MaxDispatchCases - 1) / MaxDispatchCases);
+    const bool TieredDispatch = ChunkCount > 1;
+    SmallVector<BasicBlock *, 4> ChunkHeaders;
+    SmallVector<BasicBlock *, 4> ChunkInvalids;
+    SmallVector<BasicBlock *, 4> ChunkMerges;
+    if (TieredDispatch) {
+      ChunkHeaders.reserve(ChunkCount);
+      ChunkInvalids.reserve(ChunkCount);
+      ChunkMerges.reserve(ChunkCount);
+      for (unsigned Chunk = 0; Chunk < ChunkCount; ++Chunk) {
+        ChunkHeaders.push_back(BasicBlock::Create(
+            Ctx, "cudavm.spirv.dispatch.chunk", &F, InitialBody));
+        ChunkInvalids.push_back(BasicBlock::Create(
+            Ctx, "cudavm.spirv.dispatch.chunk.invalid", &F));
+        ChunkMerges.push_back(BasicBlock::Create(
+            Ctx, "cudavm.spirv.dispatch.chunk.merge", &F));
+      }
+    }
+    BasicBlock *Invalid =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.invalid", &F);
+    BasicBlock *SwitchMerge =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.merge", &F);
+    BasicBlock *Continue =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.continue", &F);
+    BasicBlock *LoopMerge =
+        BasicBlock::Create(Ctx, "cudavm.spirv.dispatch.loop.merge", &F);
+
+    Instruction *OldEntryTerminator = Entry->getTerminator();
+    IRBuilder<> EntryBuilder(OldEntryTerminator);
+    AllocaInst *StateSlot = EntryBuilder.CreateAlloca(
+        EntryBuilder.getInt32Ty(), nullptr, "cudavm.spirv.dispatch.state");
+    EntryBuilder.CreateStore(
+        EntryBuilder.getInt32(StateForTarget(InitialBody)), StateSlot);
+    EntryBuilder.CreateBr(LoopHeader);
+    OldEntryTerminator->eraseFromParent();
+
+    // Mirror SPIRVStructurizer's representation for an infinite LLVM loop:
+    // structurally connect an unreachable merge with a constant-false edge,
+    // then place spv.loop.merge immediately before the conditional branch.
+    IRBuilder<> LoopBuilder(LoopHeader);
+    auto *LoopMergeAddress = BlockAddress::get(&F, LoopMerge);
+    auto *ContinueAddress = BlockAddress::get(&F, Continue);
+    // OpLoopMerge is: Merge Block, Continue Target, Loop Control, followed
+    // by optional Loop Control parameters. LLVM's selector copies the explicit
+    // spv_loop_merge operands verbatim, so LoopControl::None must be present.
+    SmallVector<Value *, 3> LoopMergeArgs = {
+        LoopMergeAddress, ContinueAddress, LoopBuilder.getInt32(0)};
+    LoopBuilder.CreateIntrinsic(Intrinsic::spv_loop_merge, {LoopMergeArgs});
+    LoopBuilder.CreateCondBr(LoopBuilder.getFalse(), LoopMerge, SwitchHeader);
+
+    IRBuilder<> SwitchBuilder(SwitchHeader);
+    Value *State = SwitchBuilder.CreateLoad(
+        SwitchBuilder.getInt32Ty(), StateSlot, "cudavm.spirv.dispatch.current");
+    auto *SwitchMergeAddress = BlockAddress::get(&F, SwitchMerge);
+    if (TieredDispatch) {
+      Value *DispatchKey = SwitchBuilder.CreateUDiv(
+          State, SwitchBuilder.getInt32(MaxDispatchCases),
+          "cudavm.spirv.dispatch.chunk.id");
+      SmallVector<Value *, 2> SelectionMergeArgs = {
+          SwitchMergeAddress, SwitchBuilder.getInt32(0)};
+      SwitchBuilder.CreateIntrinsic(
+          Intrinsic::spv_selection_merge,
+          {SwitchMergeAddress->getType()}, SelectionMergeArgs);
+      SwitchInst *Dispatch = SwitchBuilder.CreateSwitch(
+          DispatchKey, Invalid, ChunkCount);
+      for (unsigned Chunk = 0; Chunk < ChunkCount; ++Chunk) {
+        Dispatch->addCase(SwitchBuilder.getInt32(Chunk), ChunkHeaders[Chunk]);
+
+        IRBuilder<> ChunkBuilder(ChunkHeaders[Chunk]);
+        auto *ChunkMergeAddress = BlockAddress::get(&F, ChunkMerges[Chunk]);
+        SmallVector<Value *, 2> ChunkSelectionMergeArgs = {
+            ChunkMergeAddress, ChunkBuilder.getInt32(0)};
+        ChunkBuilder.CreateIntrinsic(
+            Intrinsic::spv_selection_merge,
+            {ChunkMergeAddress->getType()}, ChunkSelectionMergeArgs);
+        const unsigned Begin = Chunk * MaxDispatchCases;
+        const unsigned End = std::min<unsigned>(
+            static_cast<unsigned>(Blocks.size()), Begin + MaxDispatchCases);
+        SwitchInst *ChunkDispatch = ChunkBuilder.CreateSwitch(
+            State, ChunkInvalids[Chunk], End - Begin);
+        for (unsigned Index = Begin; Index < End; ++Index)
+          ChunkDispatch->addCase(ChunkBuilder.getInt32(Index), Blocks[Index]);
+
+        IRBuilder<> InvalidBuilder(ChunkInvalids[Chunk]);
+        if (F.getReturnType()->isVoidTy())
+          InvalidBuilder.CreateRetVoid();
+        else
+          InvalidBuilder.CreateRet(Constant::getNullValue(F.getReturnType()));
+        IRBuilder<>(ChunkMerges[Chunk]).CreateBr(SwitchMerge);
+      }
+    } else {
+      SmallVector<Value *, 2> SelectionMergeArgs = {
+          SwitchMergeAddress, SwitchBuilder.getInt32(0)};
+      SwitchBuilder.CreateIntrinsic(
+          Intrinsic::spv_selection_merge,
+          {SwitchMergeAddress->getType()}, SelectionMergeArgs);
+      SwitchInst *Dispatch = SwitchBuilder.CreateSwitch(
+          State, Invalid, static_cast<unsigned>(Blocks.size()));
+      for (BasicBlock *BB : Blocks)
+        Dispatch->addCase(
+            SwitchBuilder.getInt32(StateForTarget(BB)), BB);
+    }
+
+    IRBuilder<> InvalidBuilder(Invalid);
+    if (F.getReturnType()->isVoidTy())
+      InvalidBuilder.CreateRetVoid();
+    else
+      InvalidBuilder.CreateRet(Constant::getNullValue(F.getReturnType()));
+    IRBuilder<>(SwitchMerge).CreateBr(Continue);
+    IRBuilder<>(Continue).CreateBr(LoopHeader);
+    IRBuilder<> LoopMergeBuilder(LoopMerge);
+    if (F.getReturnType()->isVoidTy())
+      LoopMergeBuilder.CreateRetVoid();
+    else
+      LoopMergeBuilder.CreateRet(Constant::getNullValue(F.getReturnType()));
+
+    for (BasicBlock *BB : Blocks) {
+      Instruction *Terminator = BB->getTerminator();
+      if (isa<ReturnInst>(Terminator) || isa<UnreachableInst>(Terminator))
+        continue;
+
+      IRBuilder<> B(Terminator);
+      Value *NextState = nullptr;
+      if (auto *Branch = dyn_cast<BranchInst>(Terminator)) {
+        if (Branch->isUnconditional()) {
+          NextState =
+              B.getInt32(StateForTarget(Branch->getSuccessor(0)));
+        } else {
+          Value *TrueState =
+              B.getInt32(StateForTarget(Branch->getSuccessor(0)));
+          Value *FalseState =
+              B.getInt32(StateForTarget(Branch->getSuccessor(1)));
+          NextState = B.CreateSelect(
+              Branch->getCondition(), TrueState, FalseState,
+              "cudavm.spirv.dispatch.next");
+        }
+      } else if (auto *Switch = dyn_cast<SwitchInst>(Terminator)) {
+        NextState = B.getInt32(StateForTarget(Switch->getDefaultDest()));
+        for (auto &Case : Switch->cases()) {
+          Value *Matches =
+              B.CreateICmpEQ(Switch->getCondition(), Case.getCaseValue());
+          NextState = B.CreateSelect(
+              Matches,
+              B.getInt32(StateForTarget(Case.getCaseSuccessor())),
+              NextState, "cudavm.spirv.dispatch.case");
+        }
+      } else {
+        report_fatal_error(
+            Twine("Unsupported terminator in CUDAVM SPIR-V dispatcher for function '") +
+            F.getName() + "': " + Terminator->getOpcodeName());
+      }
+
+      B.CreateStore(NextState, StateSlot);
+      BasicBlock *DispatchMerge = TieredDispatch
+          ? ChunkMerges[StateForTarget(BB) / MaxDispatchCases]
+          : SwitchMerge;
+      B.CreateBr(DispatchMerge);
+      Terminator->eraseFromParent();
+    }
+
+    std::string VerifyDiagnostic;
+    raw_string_ostream VerifyOutput(VerifyDiagnostic);
+    if (verifyFunction(F, &VerifyOutput)) {
+      VerifyOutput.flush();
+      report_fatal_error(
+          Twine("CUDAVM canonical SPIR-V dispatcher produced invalid IR in function '") +
+          F.getName() + ":\n" + VerifyDiagnostic);
+    }
+
+    DomTreeBuilder::BBDomTree DT;
+    DT.recalculate(F);
+    LoopInfo LI(DT);
+    ReversePostOrderTraversal<Function *> RPO(&F);
+    if (containsIrreducibleCFG<BasicBlock *>(RPO, LI))
+      report_fatal_error(
+          Twine("CUDAVM canonical SPIR-V dispatcher produced irreducible CFG in function '") +
+          F.getName() + "'");
+
+    F.addFnAttr(CUDAVMDispatchAppliedAttr);
+    return true;
+  }
+};
+
+char CUDAVMCanonicalDispatchCFGPass::ID = 0;
+
+static std::string cudavmInstructionText(const Instruction &I) {
+  std::string Text;
+  raw_string_ostream OS(Text);
+  I.print(OS);
+  OS.flush();
+  return Text;
+}
+
+// The SPIR-V selector consumes merge intrinsic operands as the exact operands
+// of OpLoopMerge/OpSelectionMerge. Validate that contract while the operands
+// are still LLVM values, so malformed target IR cannot become an opaque
+// GlobalISel/spirv-val failure.
+class CUDAVMMergeContractPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMMergeContractPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM SPIR-V merge-intrinsic contract validation";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    // The second RegToMem can insert selector reloads between an annotation
+    // and a generated dispatcher switch. An annotation has no runtime effect;
+    // schedule it after those reloads without relaxing the CFG checks below.
+    if (F.hasFnAttribute(CUDAVMDispatchAppliedAttr)) {
+      SmallVector<IntrinsicInst *, 16> Merges;
+      for (BasicBlock &BB : F)
+        for (Instruction &I : BB)
+          if (auto *II = dyn_cast<IntrinsicInst>(&I))
+            if (II->getIntrinsicID() == Intrinsic::spv_selection_merge ||
+                II->getIntrinsicID() == Intrinsic::spv_loop_merge)
+              Merges.push_back(II);
+      for (IntrinsicInst *II : Merges)
+        II->moveBefore(II->getParent()->getTerminator()->getIterator());
+    }
+
+    SmallPtrSet<BasicBlock *, 32> DeclaredMergeBlocks;
+    SmallPtrSet<BasicBlock *, 32> ContinueTargets;
+
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *II = dyn_cast<IntrinsicInst>(&I);
+        if (!II)
+          continue;
+
+        const Intrinsic::ID IID = II->getIntrinsicID();
+        if (IID != Intrinsic::spv_loop_merge &&
+            IID != Intrinsic::spv_selection_merge)
+          continue;
+
+        auto Fail = [&](StringRef Reason) -> void {
+          report_fatal_error(
+              Twine("CUDAVM SPIR-V merge contract violation in function '") +
+              F.getName() + "': " + Reason + "\n  intrinsic: " +
+              cudavmInstructionText(*II));
+        };
+
+        if (IID == Intrinsic::spv_loop_merge) {
+          if (II->arg_size() != 3)
+            Fail("spv_loop_merge must have merge, continue, and loop-control operands");
+          auto *MergeBA = dyn_cast<BlockAddress>(II->getArgOperand(0));
+          auto *ContinueBA = dyn_cast<BlockAddress>(II->getArgOperand(1));
+          if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+            Fail("spv_loop_merge merge operand is not a local blockaddress");
+          if (!ContinueBA || ContinueBA->getBasicBlock()->getParent() != &F)
+            Fail("spv_loop_merge continue operand is not a local blockaddress");
+          DeclaredMergeBlocks.insert(MergeBA->getBasicBlock());
+          ContinueTargets.insert(ContinueBA->getBasicBlock());
+          auto *LoopControl = dyn_cast<ConstantInt>(II->getArgOperand(2));
+          if (!LoopControl || !LoopControl->getType()->isIntegerTy(32) ||
+              !LoopControl->isZero())
+            Fail("spv_loop_merge loop-control operand must be i32 LoopControl::None (0)");
+          if (II->getNextNode() != BB.getTerminator() ||
+              !isa<BranchInst>(BB.getTerminator()))
+            Fail("spv_loop_merge must immediately precede its loop-header branch");
+          continue;
+        }
+
+        if (II->arg_size() != 2)
+          Fail("spv_selection_merge must have merge and selection-control operands");
+        auto *MergeBA = dyn_cast<BlockAddress>(II->getArgOperand(0));
+        if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+          Fail("spv_selection_merge merge operand is not a local blockaddress");
+        DeclaredMergeBlocks.insert(MergeBA->getBasicBlock());
+        auto *SelectionControl = dyn_cast<ConstantInt>(II->getArgOperand(1));
+        if (!SelectionControl || !SelectionControl->getType()->isIntegerTy(32))
+          Fail("spv_selection_merge selection-control operand must be i32");
+        Instruction *Terminator = BB.getTerminator();
+        if (II->getNextNode() != Terminator)
+          Fail("spv_selection_merge must immediately precede its selection terminator");
+        if (auto *Branch = dyn_cast<BranchInst>(Terminator)) {
+          if (!Branch->isConditional())
+            Fail("spv_selection_merge must precede a conditional branch or switch");
+        } else if (!isa<SwitchInst>(Terminator)) {
+          Fail("spv_selection_merge must precede a conditional branch or switch");
+        }
+      }
+    }
+
+    DominatorTree DT(F);
+    auto MergeKindBeforeTerminator = [](BasicBlock &BB) -> Intrinsic::ID {
+      Instruction *Terminator = BB.getTerminator();
+      if (!Terminator)
+        return Intrinsic::not_intrinsic;
+      auto *II = dyn_cast_or_null<IntrinsicInst>(Terminator->getPrevNode());
+      return II ? II->getIntrinsicID() : Intrinsic::not_intrinsic;
+    };
+    auto FailBlock = [&](StringRef Reason, BasicBlock &BB) -> void {
+      std::string TerminatorText = cudavmInstructionText(*BB.getTerminator());
+      report_fatal_error(
+          Twine("CUDAVM SPIR-V structured-control contract violation in function '") +
+          F.getName() + "' at block '" + BB.getName() + "': " + Reason +
+          "\n  terminator: " + TerminatorText);
+    };
+
+    for (BasicBlock &BB : F) {
+      if (!DT.isReachableFromEntry(&BB))
+        continue;
+      Instruction *Terminator = BB.getTerminator();
+      const Intrinsic::ID MergeKind = MergeKindBeforeTerminator(BB);
+
+      if (isa<SwitchInst>(Terminator) &&
+          MergeKind != Intrinsic::spv_selection_merge)
+        FailBlock("switch is missing spv_selection_merge", BB);
+
+      if (auto *Branch = dyn_cast<BranchInst>(Terminator)) {
+        if (Branch->isConditional() &&
+            Branch->getSuccessor(0) != Branch->getSuccessor(1) &&
+            MergeKind != Intrinsic::spv_selection_merge &&
+            MergeKind != Intrinsic::spv_loop_merge &&
+            !DeclaredMergeBlocks.contains(Branch->getSuccessor(0)) &&
+            !DeclaredMergeBlocks.contains(Branch->getSuccessor(1)) &&
+            !ContinueTargets.contains(Branch->getSuccessor(0)) &&
+            !ContinueTargets.contains(Branch->getSuccessor(1)))
+          FailBlock("conditional branch is missing spv_selection_merge", BB);
+      }
+
+      for (BasicBlock *Succ : successors(&BB)) {
+        if (!DT.isReachableFromEntry(Succ) || !DT.dominates(Succ, &BB))
+          continue;
+        if (MergeKindBeforeTerminator(*Succ) != Intrinsic::spv_loop_merge)
+          FailBlock("backedge targets a block without spv_loop_merge", BB);
+      }
+    }
+
+    return false;
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+  }
+};
