+    CUDAVMIrreducibleSummary Summary = cudavmSummarizeIrreducibleCFG(F);
+    report_fatal_error(
+        Twine("CUDAVM local irreducible-CFG repair did not produce a reducible graph for function '") +
+        F.getName() + "' (sccs=" + Twine(Summary.SCCCount) +
+        ", blocks=" + Twine(Summary.BlockCount) +
+        ", entry-blocks=" + Twine(Summary.EntryBlockCount) +
+        ", repair-cost=" + Twine(Summary.RepairCost) + ")");
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+  }
+};
+
+char CUDAVMReducibleCFGContractPass::ID = 0;
+
+// LLVM 22's native structurizer often gets the hard part right but omits a
+// selection marker, or chooses a merge block that is not dominated by the
+// selection header. Flattening the entire function for those local annotation
+// defects recreates the code-size/driver-compile problem CUDAVM is trying to
+// avoid. Repair only the marker when the CFG already has a canonical local
+// convergence point: the nearest common post-dominator of all terminator
+// successors. If that point is not a unique, strictly dominated merge block,
+// leave the function unchanged and let the following contract select the
+// bounded dispatcher fallback.
+class CUDAVMLocalSelectionRepairPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMLocalSelectionRepairPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM local SPIR-V selection repair";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    // A merge block may only be declared by one SPIR-V header. LLVM 22 often
+    // leaves an otherwise-good selection converging at the merge block of an
+    // enclosing construct, so merely annotating the nearest common
+    // post-dominator is illegal. In that case split only the incoming edges
+    // dominated by this selection header and use the new edge-proxy block as
+    // the selection's private merge.
+    SmallPtrSet<BasicBlock *, 32> FailedHeaders;
+    unsigned Inserted = 0;
+    unsigned Retargeted = 0;
+    unsigned Proxies = 0;
+    bool Changed = false;
+
+    auto MergeKindBeforeTerminator = [](BasicBlock &BB) -> Intrinsic::ID {
+      Instruction *Terminator = BB.getTerminator();
+      if (!Terminator)
+        return Intrinsic::not_intrinsic;
+      auto *II = dyn_cast_or_null<IntrinsicInst>(Terminator->getPrevNode());
+      return II ? II->getIntrinsicID() : Intrinsic::not_intrinsic;
+    };
+
+    // Repair one header at a time and rebuild dominance/post-dominance after
+    // every proxy split. This keeps the transform simple and prevents stale
+    // analysis from being used after SplitBlockPredecessors rewrites edges.
+    while (true) {
+      DominatorTree DT(F);
+      PostDominatorTree PDT(F);
+      bool MutatedCFG = false;
+
+      DenseMap<BasicBlock *, unsigned> MergeUseCount;
+      SmallPtrSet<BasicBlock *, 32> DeclaredMergeBlocks;
+      SmallPtrSet<BasicBlock *, 32> ContinueTargets;
+      for (BasicBlock &BB : F) {
+        for (Instruction &I : BB) {
+          auto *II = dyn_cast<IntrinsicInst>(&I);
+          if (!II)
+            continue;
+          if (II->getIntrinsicID() == Intrinsic::spv_selection_merge ||
+              II->getIntrinsicID() == Intrinsic::spv_loop_merge) {
+            if (auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(0))) {
+              if (BA->getBasicBlock()->getParent() == &F) {
+                ++MergeUseCount[BA->getBasicBlock()];
+                DeclaredMergeBlocks.insert(BA->getBasicBlock());
+              }
+            }
+          }
+          if (II->getIntrinsicID() == Intrinsic::spv_loop_merge) {
+            if (auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(1)))
+              if (BA->getBasicBlock()->getParent() == &F)
+                ContinueTargets.insert(BA->getBasicBlock());
+          }
+        }
+      }
+
+      auto CanReachFunctionReturn = [&](BasicBlock *Start) {
+        SmallVector<BasicBlock *, 32> Worklist = {Start};
+        SmallPtrSet<BasicBlock *, 32> Seen;
+        while (!Worklist.empty()) {
+          BasicBlock *Block = Worklist.pop_back_val();
+          if (!Seen.insert(Block).second)
+            continue;
+          if (isa<ReturnInst>(Block->getTerminator()))
+            return true;
+          for (BasicBlock *Succ : successors(Block))
+            Worklist.push_back(Succ);
+        }
+        return false;
+      };
+
+      auto NearestConvergence = [&](BasicBlock &Header) -> BasicBlock * {
+        // Exceptional exits are commonly shared by several nested C++
+        // selections, so their target is not dominated by any one header.
+        // Prefer that shared terminal target; LocalMerge will split this
+        // header's incoming exceptional edges into a private merge proxy.
+        SmallVector<BasicBlock *, 8> ExceptionalExitTargets;
+        SmallPtrSet<BasicBlock *, 8> SeenExceptionalExitTargets;
+        for (BasicBlock &Block : F) {
+          if (!DT.isReachableFromEntry(&Block) ||
+              !DT.dominates(&Header, &Block))
+            continue;
+          for (BasicBlock *Succ : successors(&Block)) {
+            if (!CanReachFunctionReturn(Succ) &&
+                !DT.dominates(&Header, Succ) &&
+                SeenExceptionalExitTargets.insert(Succ).second)
+              ExceptionalExitTargets.push_back(Succ);
+          }
+        }
+        if (!ExceptionalExitTargets.empty()) {
+          BasicBlock *Merge = ExceptionalExitTargets.front();
+          for (unsigned I = 1; I < ExceptionalExitTargets.size(); ++I) {
+            if (!PDT.getNode(Merge) ||
+                !PDT.getNode(ExceptionalExitTargets[I]))
+              return nullptr;
+            Merge = PDT.findNearestCommonDominator(
+                Merge, ExceptionalExitTargets[I]);
+            if (!Merge)
+              return nullptr;
+          }
+          return Merge;
+        }
+
+        SmallVector<BasicBlock *, 8> ReturningSuccessors;
+        SmallVector<BasicBlock *, 8> TerminatingSuccessors;
+        SmallPtrSet<BasicBlock *, 8> Seen;
+        for (BasicBlock *Succ : successors(&Header)) {
+          if (!Seen.insert(Succ).second)
+            continue;
+          (CanReachFunctionReturn(Succ) ? ReturningSuccessors
+                                        : TerminatingSuccessors)
+              .push_back(Succ);
+        }
+        // When an arm can only terminate exceptionally, use that arm as the
+        // merge construct and let normal-returning arms terminate the
+        // selection. Including both exit classes makes the post-dominator
+        // query resolve to its virtual root and needlessly forces the whole
+        // function through the dispatcher fallback.
+        SmallVectorImpl<BasicBlock *> &Successors =
+            TerminatingSuccessors.empty() ? ReturningSuccessors
+                                          : TerminatingSuccessors;
+        if (Successors.empty())
+          return nullptr;
+        if (Successors.size() == 1)
+          return Successors.front();
+
+        BasicBlock *Merge = Successors.front();
+        for (unsigned I = 1; I < Successors.size(); ++I) {
+          if (!PDT.getNode(Merge) || !PDT.getNode(Successors[I]))
+            return nullptr;
+          Merge = PDT.findNearestCommonDominator(Merge, Successors[I]);
+          if (!Merge)
+            return nullptr;
+        }
+        if (Merge == &Header || !DT.isReachableFromEntry(Merge))
+          return nullptr;
+        return Merge;
+      };
+
+      auto ProxyMerge = [&](BasicBlock &Header,
+                            BasicBlock *Convergence) -> BasicBlock * {
+        if (!Convergence || !Convergence->canSplitPredecessors())
+          return nullptr;
+
+        // Never split a continue edge or a backedge into a loop header. Those
+        // require loop-aware restructuring rather than a local selection
+        // annotation repair.
+        if (ContinueTargets.contains(Convergence) ||
+            MergeKindBeforeTerminator(*Convergence) ==
+                Intrinsic::spv_loop_merge)
+          return nullptr;
+
+        SmallVector<BasicBlock *, 16> Preds;
+        for (BasicBlock *Pred : predecessors(Convergence)) {
+          if (!DT.isReachableFromEntry(Pred) ||
+              !DT.dominates(&Header, Pred))
+            continue;
+          if (DT.dominates(Convergence, Pred))
+            return nullptr;
+          Preds.push_back(Pred);
+        }
+        if (Preds.empty())
+          return nullptr;
+
+        BasicBlock *Proxy = SplitBlockPredecessors(
+            Convergence, Preds, ".cudavm.selection.merge", &DT);
+        if (!Proxy)
+          return nullptr;
+        ++Proxies;
+        Changed = true;
+        MutatedCFG = true;
+
+        // The split is semantics-preserving even if this check fails; in that
+        // case leave the extra edge block in place and let the following
+        // structured-CFG contract select the bounded dispatcher fallback.
+        DominatorTree NewDT(F);
+        if (!NewDT.isReachableFromEntry(Proxy) ||
+            !NewDT.dominates(&Header, Proxy))
+          return nullptr;
+        return Proxy;
+      };
+
+      auto LocalMerge = [&](BasicBlock &Header) -> BasicBlock * {
+        BasicBlock *Convergence = NearestConvergence(Header);
+        if (!Convergence)
+          return nullptr;
+
+        // Direct annotation is valid only when the merge is private to this
+        // header and already lies in its dominance region.
+        if (DT.dominates(&Header, Convergence) &&
+            !DeclaredMergeBlocks.contains(Convergence) &&
+            !ContinueTargets.contains(Convergence))
+          return Convergence;
+
+        // Otherwise isolate the selection's incoming paths from the enclosing
+        // convergence block. The fresh proxy is a unique SPIR-V merge block.
+        return ProxyMerge(Header, Convergence);
+      };
+
+      auto InsertSelectionMerge = [&](BasicBlock &Header,
+                                      BasicBlock *Merge) {
+        Instruction *Terminator = Header.getTerminator();
+        IRBuilder<> B(Terminator);
+        auto *MergeAddress = BlockAddress::get(&F, Merge);
+        SmallVector<Value *, 2> Args = {MergeAddress, B.getInt32(0)};
+        B.CreateIntrinsic(Intrinsic::spv_selection_merge,
+                          {MergeAddress->getType()}, Args);
+      };
+
+      bool RepairedOne = false;
+
+      // Build nested selections from the inside out. If several constructs
+      // share an exceptional exit, this makes their private merge proxies a
+      // properly nested chain instead of allowing a later inner proxy to
+      // bypass an already-declared outer merge.
+      SmallVector<BasicBlock *, 64> HeadersByDepth;
+      for (BasicBlock &Header : F)
+        if (DT.isReachableFromEntry(&Header))
+          HeadersByDepth.push_back(&Header);
+      std::stable_sort(HeadersByDepth.begin(), HeadersByDepth.end(),
+                       [&](BasicBlock *Left, BasicBlock *Right) {
+                         return DT.getNode(Left)->getLevel() >
+                                DT.getNode(Right)->getLevel();
+                       });
+
+      // Retarget an invalid existing merge first. A valid merge is left alone
+      // even if it is not the nearest post-dominator; the native structurizer
+      // may intentionally choose a later merge to satisfy nesting.
+      for (BasicBlock *HeaderPointer : HeadersByDepth) {
+        BasicBlock &Header = *HeaderPointer;
+        if (FailedHeaders.contains(&Header))
+          continue;
+        Instruction *Terminator = Header.getTerminator();
+        auto *II = dyn_cast_or_null<IntrinsicInst>(
+            Terminator ? Terminator->getPrevNode() : nullptr);
+        if (!II || II->getIntrinsicID() != Intrinsic::spv_selection_merge)
+          continue;
+        auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(0));
+        if (!BA || BA->getBasicBlock()->getParent() != &F)
+          continue;
+        BasicBlock *OldMerge = BA->getBasicBlock();
+        if (DT.isReachableFromEntry(OldMerge) && OldMerge != &Header &&
+            DT.dominates(&Header, OldMerge))
+          continue;
+
+        // Temporarily remove this header's declaration from uniqueness
+        // accounting so the same block does not reject its own replacement.
+        auto OldIt = MergeUseCount.find(OldMerge);
+        if (OldIt != MergeUseCount.end() && OldIt->second > 0) {
+          if (--OldIt->second == 0) {
+            MergeUseCount.erase(OldIt);
+            DeclaredMergeBlocks.erase(OldMerge);
+          }
+        }
+
+        BasicBlock *NewMerge = LocalMerge(Header);
+        if (!NewMerge) {
+          FailedHeaders.insert(&Header);
+          if (!MutatedCFG) {
+            ++MergeUseCount[OldMerge];
+            DeclaredMergeBlocks.insert(OldMerge);
+            continue;
+          }
+          RepairedOne = true;
+          break;
+        }
+        II->setArgOperand(0, BlockAddress::get(&F, NewMerge));
+        if (std::getenv("CUDAVM_TRACE_SPIRV_CFG")) {
+          errs() << "cudavm: SPIR-V retarget selection header=";
+          Header.printAsOperand(errs(), false);
+          errs() << " merge=";
+          NewMerge->printAsOperand(errs(), false);
+          errs() << "\n";
+        }
+        ++Retargeted;
+        Changed = true;
+        RepairedOne = true;
+        break;
+      }
+      if (RepairedOne)
+        continue;
+
+      // Fill missing selection declarations. Shader OpSwitch always requires
+      // one. Conditional branches need one unless they are loop headers or
+      // branch directly to an existing merge/continue target.
+      for (BasicBlock *HeaderPointer : HeadersByDepth) {
+        BasicBlock &Header = *HeaderPointer;
+        if (FailedHeaders.contains(&Header) ||
+            !DT.isReachableFromEntry(&Header))
+          continue;
+        Instruction *Terminator = Header.getTerminator();
+        Intrinsic::ID MergeKind = MergeKindBeforeTerminator(Header);
+
+        bool NeedsSelection = false;
+        if (isa<SwitchInst>(Terminator)) {
+          NeedsSelection = MergeKind == Intrinsic::not_intrinsic;
+        } else if (auto *Branch = dyn_cast<BranchInst>(Terminator)) {
+          NeedsSelection =
+              Branch->isConditional() &&
+              Branch->getSuccessor(0) != Branch->getSuccessor(1) &&
+              MergeKind == Intrinsic::not_intrinsic &&
+              !DeclaredMergeBlocks.contains(Branch->getSuccessor(0)) &&
+              !DeclaredMergeBlocks.contains(Branch->getSuccessor(1)) &&
+              !ContinueTargets.contains(Branch->getSuccessor(0)) &&
+              !ContinueTargets.contains(Branch->getSuccessor(1));
+        }
+
+        if (!NeedsSelection)
+          continue;
+
+        BasicBlock *Merge = LocalMerge(Header);
+        if (!Merge) {
+          if (std::getenv("CUDAVM_TRACE_SPIRV_CFG") &&
+              isa<SwitchInst>(Terminator)) {
+            errs() << "cudavm: SPIR-V local selection repair could not find "
+                      "switch merge:\n";
+            Header.print(errs());
+            for (BasicBlock *Succ : successors(&Header)) {
+              errs() << "cudavm:   successor ";
+              Succ->printAsOperand(errs(), false);
+              errs() << ":\n";
+              Succ->print(errs());
+            }
+          }
+          FailedHeaders.insert(&Header);
+          if (MutatedCFG) {
+            RepairedOne = true;
+            break;
+          }
+          continue;
+        }
+        InsertSelectionMerge(Header, Merge);
+        if (std::getenv("CUDAVM_TRACE_SPIRV_CFG")) {
+          errs() << "cudavm: SPIR-V insert selection header=";
+          Header.printAsOperand(errs(), false);
+          errs() << " merge=";
+          Merge->printAsOperand(errs(), false);
+          errs() << "\n";
+        }
+        ++Inserted;
+        Changed = true;
+        RepairedOne = true;
+        break;
+      }
+
+      if (!RepairedOne)
+        break;
+    }
+
+    if (Changed && std::getenv("CUDAVM_TRACE_SPIRV_CFG"))
+      errs() << "cudavm: SPIR-V local selection repair function=" << F.getName()
+             << " inserted=" << Inserted << " retargeted=" << Retargeted
+             << " proxies=" << Proxies << "\n";
+    return Changed;
+  }
+};
+
+char CUDAVMLocalSelectionRepairPass::ID = 0;
+
+// SPIR-V switch case constructs that fall through to another case must appear
+// consecutively in OpSwitch target order. LLVM SwitchInst case order has no
+// semantic effect: unique integer case values determine dispatch independently
+// of operand order. Reorder only the case operands after native structurization
+// so the structurizer's valid case-to-case edges satisfy SPIR-V's lexical case
+// ordering rule without flattening the function or changing its CFG.
+class CUDAVMSwitchCaseOrderRepairPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMSwitchCaseOrderRepairPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM local SPIR-V switch case-order repair";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    DominatorTree DT(F);
+    unsigned ReorderedSwitches = 0;
+    unsigned ReorderedCases = 0;
+    bool Changed = false;
+
+    auto MergeKindBeforeTerminator = [](BasicBlock &BB) -> Intrinsic::ID {
+      Instruction *Terminator = BB.getTerminator();
+      if (!Terminator)
+        return Intrinsic::not_intrinsic;
+      auto *II = dyn_cast_or_null<IntrinsicInst>(Terminator->getPrevNode());
+      return II ? II->getIntrinsicID() : Intrinsic::not_intrinsic;
+    };
+
+    for (BasicBlock &Header : F) {
+      auto *Switch = dyn_cast<SwitchInst>(Header.getTerminator());
+      if (!Switch || Switch->getNumCases() < 2 ||
+          MergeKindBeforeTerminator(Header) != Intrinsic::spv_selection_merge)
+        continue;
+
+      auto *MergeII = dyn_cast_or_null<IntrinsicInst>(
+          Switch->getPrevNode());
+      auto *MergeBA = MergeII
+                          ? dyn_cast<BlockAddress>(MergeII->getArgOperand(0))
+                          : nullptr;
+      if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+        continue;
+      BasicBlock *SwitchMerge = MergeBA->getBasicBlock();
+
+      // Preserve the original order for unrelated case chains and preserve the
+      // original order of values that share one destination. Only the order of
+      // destination groups constrained by actual case fall-through is changed.
+      SmallVector<BasicBlock *, 16> ListedTargets;
+      SmallPtrSet<BasicBlock *, 16> ListedSet;
+      DenseMap<BasicBlock *, SmallVector<ConstantInt *, 4>> ValuesByTarget;
+      for (auto Case : Switch->cases()) {
+        BasicBlock *Target = Case.getCaseSuccessor();
+        if (ListedSet.insert(Target).second)
+          ListedTargets.push_back(Target);
+        ValuesByTarget[Target].push_back(Case.getCaseValue());
+      }
+
+      SmallVector<BasicBlock *, 16> Targets;
+      SmallPtrSet<BasicBlock *, 16> SeenTargets;
+      auto AddTarget = [&](BasicBlock *Target) {
+        if (SeenTargets.insert(Target).second)
+          Targets.push_back(Target);
+      };
+      AddTarget(Switch->getDefaultDest());
+      for (BasicBlock *Target : ListedTargets)
+        AddTarget(Target);
+
+      // If native structurization already left a case outside the switch
+      // header's dominance region, ordering cannot repair it. The following
+      // structured-CFG contract will select the bounded dispatcher fallback.
+      bool Unsupported = false;
+      for (BasicBlock *Target : Targets) {
+        if (Target == SwitchMerge)
+          continue;
+        if (!DT.isReachableFromEntry(Target) ||
+            !DT.dominates(&Header, Target)) {
+          Unsupported = true;
+          break;
+        }
+      }
+      if (Unsupported)
+        continue;
+
+      auto CaseOwner = [&](BasicBlock *Block) -> BasicBlock * {
+        if (!DT.isReachableFromEntry(Block) ||
+            !DT.dominates(&Header, Block) || Block == SwitchMerge ||
+            DT.dominates(SwitchMerge, Block))
+          return nullptr;
+
+        BasicBlock *Owner = nullptr;
+        for (BasicBlock *Target : Targets) {
+          if (Target == SwitchMerge || !DT.dominates(Target, Block))
+            continue;
+          if (!Owner || DT.dominates(Owner, Target))
+            Owner = Target;
+        }
+        return Owner;
+      };
+
+      DenseMap<BasicBlock *, BasicBlock *> NextCase;
+      DenseMap<BasicBlock *, BasicBlock *> PreviousCase;
+      for (BasicBlock &CaseBlock : F) {
+        BasicBlock *SourceOwner = CaseOwner(&CaseBlock);
+        if (!SourceOwner)
+          continue;
+        for (BasicBlock *Succ : successors(&CaseBlock)) {
+          BasicBlock *TargetOwner = CaseOwner(Succ);
+          if (!TargetOwner || TargetOwner == SourceOwner)
+            continue;
+
+          auto NextIt = NextCase.find(SourceOwner);
+          if (NextIt != NextCase.end() && NextIt->second != TargetOwner) {
+            Unsupported = true;
+            break;
+          }
+          auto PrevIt = PreviousCase.find(TargetOwner);
+          if (PrevIt != PreviousCase.end() &&
+              PrevIt->second != SourceOwner) {
+            Unsupported = true;
+            break;
+          }
+          NextCase[SourceOwner] = TargetOwner;
+          PreviousCase[TargetOwner] = SourceOwner;
+        }
+        if (Unsupported)
+          break;
+      }
+      if (Unsupported)
+        continue;
+
+      auto IsListed = [&](BasicBlock *Target) {
+        return ListedSet.contains(Target);
+      };
+
+      // Translate SPIR-V adjacency requirements into a set of disjoint chains
+      // over the listed LLVM switch destinations. The default destination does
+      // not occupy a literal/target pair in OpSwitch, so when a listed case
+      // falls through Default and Default falls through a listed case, the two
+      // listed destinations themselves must be adjacent.
+      DenseMap<BasicBlock *, BasicBlock *> RequiredNext;
+      DenseMap<BasicBlock *, BasicBlock *> RequiredPrev;
+      for (auto &Edge : NextCase) {
+        BasicBlock *Source = Edge.first;
+        BasicBlock *Target = Edge.second;
+        if (!IsListed(Source))
+          continue;
+
+        BasicBlock *Required = nullptr;
+        if (IsListed(Target)) {
+          Required = Target;
+        } else if (Target == Switch->getDefaultDest()) {
+          auto DefaultNext = NextCase.find(Target);
+          if (DefaultNext != NextCase.end() && IsListed(DefaultNext->second))
+            Required = DefaultNext->second;
+        }
+        if (!Required)
+          continue;
+
+        if (Required == Source) {
+          Unsupported = true;
+          break;
+        }
+        auto NextIt = RequiredNext.find(Source);
+        if (NextIt != RequiredNext.end() && NextIt->second != Required) {
+          Unsupported = true;
+          break;
+        }
+        auto PrevIt = RequiredPrev.find(Required);
+        if (PrevIt != RequiredPrev.end() && PrevIt->second != Source) {
+          Unsupported = true;
+          break;
+        }
+        RequiredNext[Source] = Required;
+        RequiredPrev[Required] = Source;
+      }
+      if (Unsupported)
+        continue;
+
+      SmallVector<BasicBlock *, 16> OrderedTargets;
+      SmallPtrSet<BasicBlock *, 16> Visited;
+      auto AppendChain = [&](BasicBlock *Head) {
+        BasicBlock *Current = Head;
+        while (Current) {
+          if (!Visited.insert(Current).second) {
+            Unsupported = true;
+            return;
+          }
+          OrderedTargets.push_back(Current);
+          auto NextIt = RequiredNext.find(Current);
+          Current = NextIt == RequiredNext.end() ? nullptr : NextIt->second;
+        }
+      };
+
+      // Walking heads in original order keeps independent chains stable.
+      for (BasicBlock *Target : ListedTargets) {
+        if (RequiredPrev.find(Target) != RequiredPrev.end())
+          continue;
+        AppendChain(Target);
+        if (Unsupported)
+          break;
+      }
+      if (Unsupported || Visited.size() != ListedTargets.size())
+        continue; // Cyclic/inconsistent fall-through cannot be linearized.
+
+      struct CaseRecord {
+        ConstantInt *Value;
+        BasicBlock *Target;
+      };
+      SmallVector<CaseRecord, 32> NewCases;
+      for (BasicBlock *Target : OrderedTargets)
+        for (ConstantInt *Value : ValuesByTarget[Target])
+          NewCases.push_back({Value, Target});
+      if (NewCases.size() != Switch->getNumCases())
+        continue;
+
+      bool Differs = false;
+      unsigned Index = 0;
+      for (auto Case : Switch->cases()) {
+        if (Case.getCaseValue() != NewCases[Index].Value ||
+            Case.getCaseSuccessor() != NewCases[Index].Target)
+          Differs = true;
+        ++Index;
+      }
+      if (!Differs)
+        continue;
+
+      Index = 0;
+      for (auto Case : Switch->cases()) {
+        Case.setValue(NewCases[Index].Value);
+        Case.setSuccessor(NewCases[Index].Target);
+        ++Index;
+      }
+
+      // Branch weights are indexed by switch operand position. They are not
+      // semantic and are stale after permutation, so discard them rather than
+      // attaching a weight to the wrong case.
+      Switch->setMetadata(LLVMContext::MD_prof, nullptr);
+      ++ReorderedSwitches;
+      ReorderedCases += NewCases.size();
+      Changed = true;
+    }
+
+    if (Changed && std::getenv("CUDAVM_TRACE_SPIRV_CFG"))
+      errs() << "cudavm: SPIR-V switch case order repair function="
+             << F.getName() << " switches=" << ReorderedSwitches
+             << " cases=" << ReorderedCases << "\n";
+    return Changed;
+  }
+};
+
+char CUDAVMSwitchCaseOrderRepairPass::ID = 0;
+
+
+// LLVM's native structurizer sometimes chooses a switch merge that is locally
+// well-formed but too early: one or more case constructs bypass it and only
+// reconverge at a later post-dominator. SPIR-V forbids those edges because a
+// case construct may leave only through another case, its corresponding merge,
+// or an enclosing loop merge/continue. Retarget such switches to the actual
+// convergence point. If that point is already owned by an enclosing construct,
+// isolate only the predecessors dominated by this switch into a private proxy
+// merge. This changes no branch semantics; the full CUDAVM structured-CFG
+// contract immediately following this pass remains the authority on validity.
+class CUDAVMSwitchExitMergeRepairPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMSwitchExitMergeRepairPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM local SPIR-V switch-exit merge repair";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    SmallPtrSet<BasicBlock *, 32> FailedHeaders;
+    unsigned Retargeted = 0;
+    unsigned Proxies = 0;
+    bool Changed = false;
+    // A proxy can become the next invalid exit of the same switch. Bound
+    // repair using the original graph size, rather than its growing size.
+    const size_t RepairBudget = std::min(cudavmLocalRepairBudget(),
+                                        std::max<size_t>(1, F.size()) * 2);
+    size_t Repairs = 0;
+
+    auto MergeKindBeforeTerminator = [](BasicBlock &BB) -> Intrinsic::ID {
+      Instruction *Terminator = BB.getTerminator();
+      if (!Terminator)
+        return Intrinsic::not_intrinsic;
+      auto *II = dyn_cast_or_null<IntrinsicInst>(Terminator->getPrevNode());
+      return II ? II->getIntrinsicID() : Intrinsic::not_intrinsic;
+    };
+
+    while (true) {
+      if (Repairs++ >= RepairBudget) {
+        F.addFnAttr(CUDAVMDispatchFallbackAttr);
+        F.addFnAttr(CUDAVMStructurizationStrategyAttr,
+                    "dispatcher-fallback-switch-repair-budget");
+        errs() << "cudavm: SPIR-V switch repair budget exhausted function="
+               << F.getName() << " repairs=" << Repairs - 1 << "\n";
+        Changed = true;
+        break;
+      }
+      DominatorTree DT(F);
+      PostDominatorTree PDT(F);
+
+      SmallPtrSet<BasicBlock *, 32> DeclaredMergeBlocks;
+      SmallPtrSet<BasicBlock *, 32> LoopMergeBlocks;
+      SmallPtrSet<BasicBlock *, 32> ContinueTargets;
+      for (BasicBlock &BB : F) {
+        for (Instruction &I : BB) {
+          auto *II = dyn_cast<IntrinsicInst>(&I);
+          if (!II)
+            continue;
+          const Intrinsic::ID IID = II->getIntrinsicID();
+          if (IID != Intrinsic::spv_selection_merge &&
+              IID != Intrinsic::spv_loop_merge)
+            continue;
+          if (auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(0))) {
+            if (BA->getBasicBlock()->getParent() == &F) {
+              DeclaredMergeBlocks.insert(BA->getBasicBlock());
+              if (IID == Intrinsic::spv_loop_merge)
+                LoopMergeBlocks.insert(BA->getBasicBlock());
+            }
+          }
+          if (IID == Intrinsic::spv_loop_merge) {
+            if (auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(1)))
+              if (BA->getBasicBlock()->getParent() == &F)
+                ContinueTargets.insert(BA->getBasicBlock());
+          }
+        }
+      }
+
+      bool RepairedOne = false;
+      for (BasicBlock &Header : F) {
+        if (FailedHeaders.contains(&Header) ||
+            !DT.isReachableFromEntry(&Header))
+          continue;
+
+        auto *Switch = dyn_cast<SwitchInst>(Header.getTerminator());
+        if (!Switch)
+          continue;
+        auto *MergeII = dyn_cast_or_null<IntrinsicInst>(
+            Switch->getPrevNode());
+        if (!MergeII ||
+            MergeII->getIntrinsicID() != Intrinsic::spv_selection_merge)
+          continue;
+        auto *MergeBA =
+            dyn_cast<BlockAddress>(MergeII->getArgOperand(0));
+        if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+          continue;
+        BasicBlock *OldMerge = MergeBA->getBasicBlock();
+
+        SmallVector<BasicBlock *, 16> Targets;
+        SmallPtrSet<BasicBlock *, 16> SeenTargets;
+        auto AddTarget = [&](BasicBlock *Target) {
+          if (SeenTargets.insert(Target).second)
+            Targets.push_back(Target);
+        };
+        AddTarget(Switch->getDefaultDest());
+        for (auto &Case : Switch->cases())
+          AddTarget(Case.getCaseSuccessor());
+
+        auto CaseOwner = [&](BasicBlock *Block) -> BasicBlock * {
+          if (!DT.isReachableFromEntry(Block) ||
+              !DT.dominates(&Header, Block) || Block == OldMerge ||
+              DT.dominates(OldMerge, Block))
+            return nullptr;
+
+          BasicBlock *Owner = nullptr;
+          for (BasicBlock *Target : Targets) {
+            if (Target == OldMerge || !DT.dominates(Target, Block))
+              continue;
+            if (!Owner || DT.dominates(Owner, Target))
+              Owner = Target;
+          }
+          return Owner;
+        };
+
+        BasicBlock *InvalidExitTarget = nullptr;
+        for (BasicBlock &CaseBlock : F) {
+          BasicBlock *SourceOwner = CaseOwner(&CaseBlock);
+          if (!SourceOwner)
+            continue;
+          for (BasicBlock *Succ : successors(&CaseBlock)) {
+            BasicBlock *TargetOwner = CaseOwner(Succ);
+            if (TargetOwner == SourceOwner || TargetOwner)
+              continue;
+            if (Succ == OldMerge || LoopMergeBlocks.contains(Succ) ||
+                ContinueTargets.contains(Succ))
+              continue;
+            InvalidExitTarget = Succ;
+            break;
+          }
+          if (InvalidExitTarget)
+            break;
+        }
+        if (!InvalidExitTarget)
+          continue;
+
+        // Find the actual convergence of every switch successor. An invalid
+        // case exit means the current merge is generally before this point.
+        BasicBlock *Convergence = nullptr;
+        for (BasicBlock *Succ : successors(&Header)) {
+          if (!PDT.getNode(Succ)) {
+            Convergence = nullptr;
+            break;
+          }
+          Convergence = Convergence
+                            ? PDT.findNearestCommonDominator(Convergence, Succ)
+                            : Succ;
+          if (!Convergence)
+            break;
+        }
+        if (!Convergence || Convergence == &Header ||
+            Convergence == OldMerge ||
+            !DT.isReachableFromEntry(Convergence))
+          Convergence = InvalidExitTarget;
+        if (!Convergence || Convergence == &Header ||
+            Convergence == OldMerge ||
+            !DT.isReachableFromEntry(Convergence)) {
+          FailedHeaders.insert(&Header);
+          continue;
+        }
+
+        // Never split a continue edge or a backedge into a loop header. Those
+        // need loop-aware restructuring and remain on the bounded fallback.
+        if (ContinueTargets.contains(Convergence) ||
+            MergeKindBeforeTerminator(*Convergence) ==
+                Intrinsic::spv_loop_merge) {
+          FailedHeaders.insert(&Header);
+          continue;
+        }
+
+        BasicBlock *NewMerge = nullptr;
+        bool MutatedCFG = false;
+        if (DT.dominates(&Header, Convergence) &&
+            !DeclaredMergeBlocks.contains(Convergence)) {
+          NewMerge = Convergence;
+        } else if (Convergence->canSplitPredecessors()) {
+          SmallVector<BasicBlock *, 16> Preds;
+          bool HasBackedge = false;
+          for (BasicBlock *Pred : predecessors(Convergence)) {
+            if (!DT.isReachableFromEntry(Pred) ||
+                !DT.dominates(&Header, Pred))
+              continue;
+            if (DT.dominates(Convergence, Pred)) {
+              HasBackedge = true;
+              break;
+            }
+            Preds.push_back(Pred);
+          }
+          if (!HasBackedge && !Preds.empty()) {
+            BasicBlock *Proxy = SplitBlockPredecessors(
+                Convergence, Preds, ".cudavm.switch.exit.merge", &DT);
+            if (Proxy) {
+              ++Proxies;
+              Changed = true;
+              MutatedCFG = true;
+
+              DominatorTree NewDT(F);
+              bool ValidProxy =
+                  NewDT.isReachableFromEntry(Proxy) &&
+                  NewDT.dominates(&Header, Proxy);
+              if (ValidProxy)
+                NewMerge = Proxy;
+            }
+          }
+        }
+
+        if (!NewMerge) {
+          FailedHeaders.insert(&Header);
+          // A predecessor split above is semantics-preserving even if it did
+          // not become a legal private merge. Rebuild analyses and continue;
+          // the following contract can still choose whole-function fallback.
+          if (MutatedCFG) {
+            RepairedOne = true;
+            break;
+          }
+          continue;
+        }
+
+        MergeII->setArgOperand(0, BlockAddress::get(&F, NewMerge));
+        ++Retargeted;
+        Changed = true;
+        RepairedOne = true;
+        break;
+      }
+
+      if (!RepairedOne)
+        break;
+    }
+
+    if (Changed && std::getenv("CUDAVM_TRACE_SPIRV_CFG"))
+      errs() << "cudavm: SPIR-V switch exit merge repair function="
+             << F.getName() << " retargeted=" << Retargeted
+             << " proxies=" << Proxies << "\n";
+    return Changed;
+  }
+};
+
+char CUDAVMSwitchExitMergeRepairPass::ID = 0;
+
+
+
+// LLVM 22's native structurizer can itself create invalid SSA dominance while
+// splitting/proxying larger C++ CFGs. Do not let a local merge annotation make
+// such a function look structurally acceptable: invalid native IR must take the
+// late memory-state dispatcher, which re-demotes cross-block scalar SSA before
+// rewiring the CFG.
+class CUDAVMPostNativeIRFallbackPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMPostNativeIRFallbackPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM post-native SPIR-V IR validity boundary";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    raw_null_ostream NullOS;
+    if (!verifyFunction(F, &NullOS))
+      return false;
+
+    F.addFnAttr(CUDAVMDispatchFallbackAttr);
+    F.addFnAttr(CUDAVMStructurizationStrategyAttr,
+                "dispatcher-fallback-native-invalid-ir");
+    errs() << "cudavm: SPIR-V native-structure fallback function="
+           << F.getName()
+           << " reason=invalid-ir-after-native-structurizer\n";
+    return true;
+  }
+};
+
+char CUDAVMPostNativeIRFallbackPass::ID = 0;
+
+// Validate the structured-control entry rule that spirv-val enforces after
+// LLVM's native structurizer.  A selection construct is the region dominated
+// by its header, excluding the merge block and everything dominated by that
+// merge. Any branch from outside that construct must enter through the header.
+// LLVM 22 can produce a locally compact CFG that violates this rule on larger
+// C++ functions; detect it while we still have LLVM IR and route only that
+// function through CUDAVM's bounded fallback.
+class CUDAVMNativeStructuredCFGContractPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMNativeStructuredCFGContractPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM native SPIR-V structured-CFG contract";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchFallbackAttr))
+      return false;
+
+    DomTreeBuilder::BBDomTree DT;
+    DT.recalculate(F);
+
+    auto MarkFallback = [&](StringRef Reason, BasicBlock *Header,
+                            BasicBlock *Source, BasicBlock *Target) -> bool {
+      F.addFnAttr(CUDAVMDispatchFallbackAttr);
+      F.addFnAttr(CUDAVMStructurizationStrategyAttr,
+                  "dispatcher-fallback-native-validate");
+      errs() << "cudavm: SPIR-V native-structure fallback function="
+             << F.getName() << " reason=" << Reason;
+      if (Header) {
+        errs() << " header=";
+        Header->printAsOperand(errs(), false);
+      }
+      if (Source) {
+        errs() << " source=";
+        Source->printAsOperand(errs(), false);
+      }
+      if (Target) {
+        errs() << " target=";
+        Target->printAsOperand(errs(), false);
+      }
+      errs() << "\n";
+      return true;
+    };
+
+    SmallPtrSet<BasicBlock *, 32> DeclaredMergeBlocks;
+    SmallPtrSet<BasicBlock *, 32> LoopMergeBlocks;
+    SmallPtrSet<BasicBlock *, 32> ContinueTargets;
+    DenseMap<BasicBlock *, BasicBlock *> MergeOwner;
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *II = dyn_cast<IntrinsicInst>(&I);
+        if (!II)
+          continue;
+        const Intrinsic::ID IID = II->getIntrinsicID();
+        if (IID != Intrinsic::spv_selection_merge &&
+            IID != Intrinsic::spv_loop_merge)
+          continue;
+
+        Instruction *Terminator = BB.getTerminator();
+        if (IID == Intrinsic::spv_selection_merge) {
+          bool IsSelectionTerminator = isa<SwitchInst>(Terminator);
+          if (auto *Branch = dyn_cast_or_null<BranchInst>(Terminator))
+            IsSelectionTerminator |= Branch->isConditional();
+          if (II->getNextNode() != Terminator || !IsSelectionTerminator)
+            return MarkFallback("invalid-selection-merge-placement", &BB,
+                                &BB, nullptr);
+        } else {
+          if (II->getNextNode() != Terminator ||
+              !isa<BranchInst>(Terminator))
+            return MarkFallback("invalid-loop-merge-placement", &BB, &BB,
+                                nullptr);
+        }
+
+        auto *MergeBA = dyn_cast<BlockAddress>(II->getArgOperand(0));
+        if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+          return MarkFallback("invalid-merge-address", &BB, &BB, nullptr);
+        BasicBlock *Merge = MergeBA->getBasicBlock();
+        auto OwnerIt = MergeOwner.find(Merge);
+        if (OwnerIt != MergeOwner.end() && OwnerIt->second != &BB)
+          return MarkFallback("merge-block-shared-by-headers", &BB,
+                              OwnerIt->second, Merge);
+        MergeOwner[Merge] = &BB;
+        DeclaredMergeBlocks.insert(Merge);
+
+        if (IID == Intrinsic::spv_loop_merge) {
+          LoopMergeBlocks.insert(Merge);
+          if (auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(1)))
+            if (BA->getBasicBlock()->getParent() == &F)
+              ContinueTargets.insert(BA->getBasicBlock());
+        }
+      }
+    }
+
+    auto MergeKindBeforeTerminator = [](BasicBlock &BB) -> Intrinsic::ID {
+      Instruction *Terminator = BB.getTerminator();
+      if (!Terminator)
+        return Intrinsic::not_intrinsic;
+      auto *II = dyn_cast_or_null<IntrinsicInst>(Terminator->getPrevNode());
+      return II ? II->getIntrinsicID() : Intrinsic::not_intrinsic;
+    };
+
+    // Shader structured-control completeness. LLVM 22 can finish its native
+    // structurizer while omitting a required selection merge or while leaving
+    // a backedge aimed at a block that is not a loop header. Detect those
+    // exact SPIR-V-invalid shapes before emission and use CUDAVM's fallback.
+    for (BasicBlock &BB : F) {
+      if (!DT.isReachableFromEntry(&BB))
+        continue;
+      Instruction *Terminator = BB.getTerminator();
+      const Intrinsic::ID MergeKind = MergeKindBeforeTerminator(BB);
+
+      if (auto *Switch = dyn_cast<SwitchInst>(Terminator)) {
+        if (MergeKind != Intrinsic::spv_selection_merge) {
+          if (std::getenv("CUDAVM_TRACE_SPIRV_CFG")) {
+            errs() << "cudavm: SPIR-V switch missing selection merge:\n";
+            BB.print(errs());
+          }
+          return MarkFallback("switch-without-selection-merge", &BB, &BB,
+                              nullptr);
+        }
+
+        auto *MergeII = dyn_cast_or_null<IntrinsicInst>(
+            Terminator->getPrevNode());
+        auto *MergeBA = MergeII
+                            ? dyn_cast<BlockAddress>(MergeII->getArgOperand(0))
+                            : nullptr;
+        if (!MergeBA || MergeBA->getBasicBlock()->getParent() != &F)
+          return MarkFallback("invalid-switch-merge-address", &BB, &BB,
+                              nullptr);
+        BasicBlock *SwitchMerge = MergeBA->getBasicBlock();
+
+        // Shader switch constructs have additional rules beyond an ordinary
+        // LLVM switch: the switch header must dominate every case construct,
+        // repeated target labels must be consecutive, and fall-through case
+        // constructs must appear consecutively in the OpSwitch target list.
+        SmallVector<BasicBlock *, 16> Targets;
+        SmallPtrSet<BasicBlock *, 16> SeenTargets;
+        auto AddTarget = [&](BasicBlock *Target) {
+          if (SeenTargets.insert(Target).second)
+            Targets.push_back(Target);
+        };
+        AddTarget(Switch->getDefaultDest());
+
+        DenseMap<BasicBlock *, unsigned> FirstCaseIndex;
+        DenseMap<BasicBlock *, unsigned> LastCaseIndex;
+        unsigned CaseIndex = 0;
+        for (auto &Case : Switch->cases()) {
+          BasicBlock *Target = Case.getCaseSuccessor();
+          AddTarget(Target);
+          auto FirstIt = FirstCaseIndex.find(Target);
+          if (FirstIt == FirstCaseIndex.end()) {
+            FirstCaseIndex[Target] = CaseIndex;
+            LastCaseIndex[Target] = CaseIndex;
+          } else {
+            if (LastCaseIndex[Target] + 1 != CaseIndex)
+              return MarkFallback("switch-target-labels-not-consecutive",
+                                  &BB, &BB, Target);
+            LastCaseIndex[Target] = CaseIndex;
+          }
+          ++CaseIndex;
+        }
+
+        for (BasicBlock *Target : Targets) {
+          if (Target == SwitchMerge)
+            continue;
+          if (!DT.isReachableFromEntry(Target) ||
+              !DT.dominates(&BB, Target))
+            return MarkFallback("switch-header-does-not-dominate-case",
+                                &BB, &BB, Target);
+        }
+
+        auto CaseOwner = [&](BasicBlock *Block) -> BasicBlock * {
+          if (!DT.isReachableFromEntry(Block) ||
+              !DT.dominates(&BB, Block) || Block == SwitchMerge ||
+              DT.dominates(SwitchMerge, Block))
+            return nullptr;
+
+          BasicBlock *Owner = nullptr;
+          for (BasicBlock *Target : Targets) {
+            if (Target == SwitchMerge || !DT.dominates(Target, Block))
+              continue;
+            if (!Owner || DT.dominates(Owner, Target))
+              Owner = Target;
+          }
+          return Owner;
+        };
+
+        DenseMap<BasicBlock *, BasicBlock *> NextCase;
+        DenseMap<BasicBlock *, BasicBlock *> PreviousCase;
+        for (BasicBlock &CaseBlock : F) {
+          BasicBlock *SourceOwner = CaseOwner(&CaseBlock);
+          if (!SourceOwner)
+            continue;
+          for (BasicBlock *Succ : successors(&CaseBlock)) {
+            BasicBlock *TargetOwner = CaseOwner(Succ);
+            if (TargetOwner == SourceOwner)
+              continue;
+            if (!TargetOwner) {
+              // spirv-val permits a case construct to leave through its
+              // switch merge, or through an enclosing loop's merge/continue.
+              // Any other branch leaves the case construct through an
+              // unstructured edge.
+              if (Succ == SwitchMerge || LoopMergeBlocks.contains(Succ) ||
+                  ContinueTargets.contains(Succ))
+                continue;
+              return MarkFallback("switch-case-invalid-exit", &BB,
+                                  &CaseBlock, Succ);
+            }
+            auto NextIt = NextCase.find(SourceOwner);
+            if (NextIt != NextCase.end() && NextIt->second != TargetOwner)
+              return MarkFallback("switch-case-branches-to-multiple-cases",
+                                  &BB, SourceOwner, TargetOwner);
+            auto PrevIt = PreviousCase.find(TargetOwner);
+            if (PrevIt != PreviousCase.end() &&
+                PrevIt->second != SourceOwner)
+              return MarkFallback("switch-case-has-multiple-fallthroughs",
+                                  &BB, SourceOwner, TargetOwner);
+            NextCase[SourceOwner] = TargetOwner;
+            PreviousCase[TargetOwner] = SourceOwner;
+          }
+        }
+
+        auto CaseIsListed = [&](BasicBlock *Target) {
+          return FirstCaseIndex.find(Target) != FirstCaseIndex.end();
+        };
+        for (auto &Edge : NextCase) {
+          BasicBlock *Source = Edge.first;
+          BasicBlock *Target = Edge.second;
+          if (!CaseIsListed(Source))
+            continue;
+
+          BasicBlock *RequiredNext = nullptr;
+          if (CaseIsListed(Target)) {
+            RequiredNext = Target;
+          } else if (Target == Switch->getDefaultDest()) {
+            // If a case falls through to an unlisted Default which then falls
+            // through to another listed case, SPIR-V requires those two case
+            // labels to be adjacent in the OpSwitch operand list.
+            auto DefaultNext = NextCase.find(Target);
+            if (DefaultNext != NextCase.end() &&
+                CaseIsListed(DefaultNext->second))
+              RequiredNext = DefaultNext->second;
+          }
+
+          if (RequiredNext &&
+              LastCaseIndex[Source] + 1 != FirstCaseIndex[RequiredNext])
+            return MarkFallback("switch-case-target-order-invalid", &BB,
+                                Source, RequiredNext);
+        }
+      }
+
+      if (auto *Branch = dyn_cast<BranchInst>(Terminator)) {
+        if (Branch->isConditional() &&
+            Branch->getSuccessor(0) != Branch->getSuccessor(1) &&
+            MergeKind != Intrinsic::spv_selection_merge &&
+            MergeKind != Intrinsic::spv_loop_merge &&
+            !DeclaredMergeBlocks.contains(Branch->getSuccessor(0)) &&
+            !DeclaredMergeBlocks.contains(Branch->getSuccessor(1)) &&
+            !ContinueTargets.contains(Branch->getSuccessor(0)) &&
+            !ContinueTargets.contains(Branch->getSuccessor(1)))
+          return MarkFallback("conditional-without-selection-merge", &BB,
+                              &BB, nullptr);
+      }
+
+      for (BasicBlock *Succ : successors(&BB)) {
+        if (!DT.isReachableFromEntry(Succ) || !DT.dominates(Succ, &BB))
+          continue;
+        if (MergeKindBeforeTerminator(*Succ) != Intrinsic::spv_loop_merge)
+          return MarkFallback("backedge-target-is-not-loop-header", Succ,
+                              &BB, Succ);
+      }
+    }
+
+    // Validate selection dominance/entry constraints as well. A selection
+    // construct is the region dominated by its header, excluding the merge
+    // block and everything dominated by that merge. No edge may enter the
+    // construct body from outside except through the header.
+    for (BasicBlock &Header : F) {
+      if (!DT.isReachableFromEntry(&Header))
+        continue;
+
+      for (Instruction &I : Header) {
+        auto *II = dyn_cast<IntrinsicInst>(&I);
+        if (!II || II->getIntrinsicID() != Intrinsic::spv_selection_merge)
+          continue;
+
+        auto *BA = dyn_cast<BlockAddress>(II->getArgOperand(0));
+        if (!BA || BA->getBasicBlock()->getParent() != &F)
+          return MarkFallback("invalid-selection-merge-address", &Header,
+                              nullptr, nullptr);
+
+        BasicBlock *Merge = BA->getBasicBlock();
+        if (!DT.isReachableFromEntry(Merge))
+          continue;
+        if (!DT.dominates(&Header, Merge) || &Header == Merge)
+          return MarkFallback("selection-header-does-not-dominate-merge",
+                              &Header, nullptr, Merge);
+
+        auto InConstruct = [&](BasicBlock *BB) {
+          return BB != Merge && DT.isReachableFromEntry(BB) &&
+                 DT.dominates(&Header, BB) && !DT.dominates(Merge, BB);
+        };
+
+        for (BasicBlock &Target : F) {
+          if (&Target == &Header || !InConstruct(&Target))
+            continue;
+          for (BasicBlock *Source : predecessors(&Target)) {
+            if (!DT.isReachableFromEntry(Source) || InConstruct(Source))
+              continue;
+            return MarkFallback("branch-enters-selection-body", &Header,
+                                Source, &Target);
+          }
+        }
+
+        // Switch case exits have their own rules and were validated above.
+        // For an ordinary conditional selection, every branch that leaves
+        // the construct must leave through this selection's merge block.
+        auto *HeaderBranch = dyn_cast<BranchInst>(Header.getTerminator());
+        if (HeaderBranch && HeaderBranch->isConditional()) {
+          for (BasicBlock &Source : F) {
+            if (!InConstruct(&Source))
+              continue;
+            for (BasicBlock *Target : successors(&Source)) {
+              if (InConstruct(Target) || Target == Merge)
+                continue;
+              return MarkFallback("selection-invalid-exit", &Header,
+                                  &Source, Target);
+            }
+          }
+        }
+      }
+    }
+
+    return false;
+  }
+};
