+static bool cudavmPointerCastUserSupportedByNativeLegalizer(const User *U) {
+  if (isa<LoadInst>(U) || isa<StoreInst>(U))
+    return true;
+
+  auto *II = dyn_cast<IntrinsicInst>(U);
+  if (!II)
+    return false;
+
+  switch (II->getIntrinsicID()) {
+  case Intrinsic::spv_assign_ptr_type:
+  case Intrinsic::spv_gep:
+  case Intrinsic::spv_store:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// LLVM's logical-pointer legalizer is intentionally exhaustive: every
+// spv_ptrcast must be consumed by one of the user forms it knows how to
+// rewrite. LLVM 22 otherwise reaches llvm_unreachable for an unsupported user.
+// Check the same precondition immediately before the native pass and report the
+// concrete producer/user pair instead of crashing inside the legalizer.
+class CUDAVMPtrcastContractPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMPtrcastContractPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM SPIR-V logical pointer-cast contract validation";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *PtrCast = dyn_cast<IntrinsicInst>(&I);
+        if (!PtrCast || PtrCast->getIntrinsicID() != Intrinsic::spv_ptrcast)
+          continue;
+
+        for (Use &U : PtrCast->uses()) {
+          User *Consumer = U.getUser();
+          if (cudavmPointerCastUserSupportedByNativeLegalizer(Consumer))
+            continue;
+
+          std::string UserText;
+          if (auto *UserI = dyn_cast<Instruction>(Consumer))
+            UserText = cudavmInstructionText(*UserI);
+          else {
+            raw_string_ostream OS(UserText);
+            Consumer->print(OS);
+            OS.flush();
+          }
+
+          report_fatal_error(
+              Twine("CUDAVM SPIR-V pointer-cast contract violation in function '") +
+              F.getName() +
+              "': native SPIRVLegalizePointerCast does not support this spv_ptrcast user" +
+              "\n  ptrcast: " + cudavmInstructionText(*PtrCast) +
+              "\n  user operand: " + Twine(U.getOperandNo()) +
+              "\n  user: " + UserText);
+        }
+      }
+    }
+    return false;
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+  }
+};
+
+char CUDAVMPtrcastContractPass::ID = 0;
+
+// SPIRVEmitIntrinsics owns ordinary LLVM bitcasts. LLVM 22's logical-pointer
+// legalization can itself synthesize a vector reinterpretation afterwards;
+// canonicalize only those *remaining* raw vector bitcasts here, immediately
+// before the generic ISel preparation/IRTranslator boundary.
+class CUDAVMPostPointerVectorBitcastPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMPostPointerVectorBitcastPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM post-pointer SPIR-V vector bitcast canonicalization";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    SmallVector<BitCastInst *, 16> Casts;
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *Cast = dyn_cast<BitCastInst>(&I);
+        if (!Cast)
+          continue;
+        Type *SrcTy = Cast->getOperand(0)->getType();
+        Type *DstTy = Cast->getType();
+        if (!SrcTy->isVectorTy() && !DstTy->isVectorTy())
+          continue;
+        Casts.push_back(Cast);
+      }
+    }
+
+    for (BitCastInst *Cast : Casts) {
+      IRBuilder<> B(Cast);
+      Value *Replacement = B.CreateIntrinsic(
+          Intrinsic::spv_bitcast,
+          {Cast->getType(), Cast->getOperand(0)->getType()},
+          {Cast->getOperand(0)});
+      Replacement->takeName(Cast);
+      Cast->replaceAllUsesWith(Replacement);
+      Cast->eraseFromParent();
+    }
+
+    if (!Casts.empty()) {
+      std::string VerifyDiagnostic;
+      raw_string_ostream VerifyOutput(VerifyDiagnostic);
+      if (verifyFunction(F, &VerifyOutput)) {
+        VerifyOutput.flush();
+        report_fatal_error(
+            Twine("CUDAVM post-pointer vector-bitcast legalization produced invalid IR in function '") +
+            F.getName() + ":\n" + VerifyDiagnostic);
+      }
+    }
+    return !Casts.empty();
+  }
+};
