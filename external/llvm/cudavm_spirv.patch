+// RegToMem is temporary on the native/local path, where compact scalar SSA is
+// restored after structurization. Canonical-dispatch fallback is intentionally
+// different: its spill/state slots remain in Function memory because promoting
+// them produces global PHIs with one incoming value per dispatcher state.
+// Pointer objects are always left in memory. The pre-RegToMem pointer contract
+// guarantees that no resource pointer value enters synthetic scalar state.
+class CUDAVMScalarStatePromotionPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMScalarStatePromotionPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM structured CFG non-pointer state promotion";
+  }
+
+  bool runOnFunction(Function &F) override {
+    // Native-local CFGs benefit from mem2reg after structurization. A canonical
+    // dispatcher does not: promoting its spill/state slots creates one PHI arm
+    // per state and recreates the O(blocks * live-state) serialization blowup.
+    // Keep fallback functions in compact memory-state form deliberately.
+    if (F.isDeclaration() || F.hasFnAttribute(CUDAVMDispatchAppliedAttr))
+      return false;
+
+    SmallVector<AllocaInst *, 64> Allocas;
+    for (Instruction &I : F.getEntryBlock()) {
+      auto *AI = dyn_cast<AllocaInst>(&I);
+      if (!AI)
+        continue;
+
+      // Pointer objects remain in Function memory: promoting them can create
+      // pointer PHIs that LLVM 22's logical-pointer legalizer cannot rewrite.
+      if (AI->getAllocatedType()->isPointerTy())
+        continue;
+
+      const bool SyntheticRegToMem = AI->getName().contains("reg2mem");
+      const bool DispatcherState =
+          AI->getName() == "cudavm.spirv.dispatch.state";
+      if (!isAllocaPromotable(AI)) {
+        if (SyntheticRegToMem || DispatcherState)
+          report_fatal_error(
+              Twine("CUDAVM synthetic structured-control state is not promotable in function '") +
+              F.getName() + "':\n  alloca: " + cudavmInstructionText(*AI));
+        continue;
+      }
+      Allocas.push_back(AI);
+    }
+
+    if (Allocas.empty())
+      return false;
+
+    DominatorTree DT(F);
+    PromoteMemToReg(Allocas, DT);
+
+    // RegToMem/dispatcher scalar state must disappear completely. Source
+    // pointer allocas are intentionally excluded and were checked earlier.
+    for (Instruction &I : F.getEntryBlock()) {
+      auto *AI = dyn_cast<AllocaInst>(&I);
+      if (!AI || AI->getAllocatedType()->isPointerTy())
+        continue;
+      if (AI->getName().contains("reg2mem") ||
+          AI->getName() == "cudavm.spirv.dispatch.state")
+        report_fatal_error(
+            Twine("CUDAVM structured-control promotion left synthetic state in function '") +
+            F.getName() + ":\n  alloca: " + cudavmInstructionText(*AI));
+    }
+    return true;
+  }
+};
