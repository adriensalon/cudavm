+// Scalar/vector PHIs are expected after state promotion and are precisely the
+// compact SSA representation we want. Pointer PHIs are still forbidden: LLVM
+// 22's logical SPIR-V pointer-cast legalization cannot rewrite spv_ptrcast on
+// PHI incoming edges. Keep that pointer-only invariant explicit.
+class CUDAVMStateMachineSSAContractPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMStateMachineSSAContractPass() : FunctionPass(ID) {}
+  StringRef getPassName() const override {
+    return "CUDAVM structured CFG pointer-SSA contract";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    for (BasicBlock &BB : F) {
+      for (Instruction &I : BB) {
+        auto *Phi = dyn_cast<PHINode>(&I);
+        if (!Phi || !Phi->getType()->isPointerTy())
+          continue;
+        report_fatal_error(
+            Twine("CUDAVM structured SPIR-V pointer-SSA contract violation in function '") +
+            F.getName() +
+            "': pointer PHI reached logical-pointer legalization\n  phi: " +
+            cudavmInstructionText(*Phi));
+      }
+    }
+    return false;
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+  }
+};
