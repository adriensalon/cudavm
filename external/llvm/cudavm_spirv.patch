+// Read-only boundary diagnostics retained from v9. They are silent for a valid,
+// fully reachable reducible graph unless CUDAVM_TRACE_SPIRV_CFG selects it.
+class CUDAVMCFGDiagnosticsPass final : public FunctionPass {
+public:
+  static char ID;
+
+  CUDAVMCFGDiagnosticsPass() : FunctionPass(ID), Stage("unspecified") {}
+  explicit CUDAVMCFGDiagnosticsPass(StringRef Stage)
+      : FunctionPass(ID), Stage(Stage.str()) {}
+  StringRef getPassName() const override {
+    return "CUDAVM SPIR-V CFG diagnostics";
+  }
+
+  bool runOnFunction(Function &F) override {
+    if (F.isDeclaration())
+      return false;
+
+    std::string VerifyDiagnostic;
+    raw_string_ostream VerifyOutput(VerifyDiagnostic);
+    const bool Invalid = verifyFunction(F, &VerifyOutput);
+
+    bool Irreducible = false;
+    size_t ReachableCount = 0;
+    DomTreeBuilder::BBDomTree DT;
+    if (!Invalid) {
+      DT.recalculate(F);
+      LoopInfo LI(DT);
+      ReversePostOrderTraversal<Function *> RPO(&F);
+      for (BasicBlock *BB : RPO) {
+        (void)BB;
+        ++ReachableCount;
+      }
+      Irreducible = containsIrreducibleCFG<BasicBlock *>(RPO, LI);
+    }
+    const bool HasUnreachable = !Invalid && ReachableCount != F.size();
+
+    const char *FilterValue = std::getenv("CUDAVM_TRACE_SPIRV_CFG");
+    bool Trace = false;
+    if (FilterValue != nullptr) {
+      StringRef Filter(FilterValue);
+      Trace = Filter.empty() || Filter == "1" || Filter == "all" ||
+              F.getName().contains(Filter);
+    }
+
+    size_t EdgeCount = 0;
+    size_t InstructionCount = 0;
+    size_t PhiCount = 0;
+    size_t PhiIncomingCount = 0;
+    size_t MaxPhiFanIn = 0;
+    size_t AllocaCount = 0;
+    size_t LoadCount = 0;
+    size_t StoreCount = 0;
+    size_t MergeIntrinsicCount = 0;
+    for (BasicBlock &BB : F) {
+      EdgeCount += succ_size(&BB);
+      for (Instruction &I : BB) {
+        ++InstructionCount;
+        if (auto *Phi = dyn_cast<PHINode>(&I)) {
+          ++PhiCount;
+          PhiIncomingCount += Phi->getNumIncomingValues();
+          MaxPhiFanIn = std::max<size_t>(MaxPhiFanIn,
+                                        Phi->getNumIncomingValues());
+        }
+        AllocaCount += isa<AllocaInst>(I);
+        LoadCount += isa<LoadInst>(I);
+        StoreCount += isa<StoreInst>(I);
+        if (auto *II = dyn_cast<IntrinsicInst>(&I))
+          MergeIntrinsicCount +=
+              II->getIntrinsicID() == Intrinsic::spv_loop_merge ||
+              II->getIntrinsicID() == Intrinsic::spv_selection_merge;
+      }
+    }
+
+    const bool PathologicalPhi =
+        MaxPhiFanIn > 32 || PhiIncomingCount > 4096;
+    if (!Trace && !Invalid && !HasUnreachable && !Irreducible &&
+        !PathologicalPhi)
+      return false;
+
+    StringRef Strategy = "unset";
+    Attribute StrategyAttr = F.getFnAttribute(CUDAVMStructurizationStrategyAttr);
+    if (StrategyAttr.isValid())
+      Strategy = StrategyAttr.getValueAsString();
+
+    errs() << "cudavm: SPIR-V CFG stage=" << Stage
+           << " function=" << F.getName() << " blocks=" << F.size()
+           << " edges=" << EdgeCount << " valid=" << !Invalid
+           << " reachable=" << ReachableCount
+           << " unreachable=" << (!Invalid ? F.size() - ReachableCount : 0)
+           << " reducible=" << (!Invalid && !Irreducible)
+           << " strategy=" << Strategy
+           << " instructions=" << InstructionCount
+           << " phis=" << PhiCount
+           << " phi_incoming=" << PhiIncomingCount
+           << " max_phi_fanin=" << MaxPhiFanIn
+           << " allocas=" << AllocaCount
+           << " loads=" << LoadCount
+           << " stores=" << StoreCount
+           << " merges=" << MergeIntrinsicCount
+           << " pathological_phi=" << PathologicalPhi << "\n";
+
+    if (Invalid) {
+      VerifyOutput.flush();
+      errs() << "cudavm: SPIR-V verifier failure stage=" << Stage
+             << " function=" << F.getName() << "\n" << VerifyDiagnostic;
+    }
+
+    if (Irreducible) {
+      for (auto I = scc_begin(&F); !I.isAtEnd(); ++I) {
+        const std::vector<BasicBlock *> &SCC = *I;
+        bool Cyclic = SCC.size() > 1;
+        if (!Cyclic && !SCC.empty()) {
+          for (BasicBlock *Succ : successors(SCC.front()))
+            Cyclic |= Succ == SCC.front();
+        }
+        if (!Cyclic)
+          continue;
+
+        SmallPtrSet<BasicBlock *, 16> Members;
+        for (BasicBlock *BB : SCC)
+          Members.insert(BB);
+
+        SmallPtrSet<BasicBlock *, 8> EntryBlocks;
+        for (BasicBlock *BB : SCC) {
+          if (!DT.isReachableFromEntry(BB))
+            continue;
+          for (BasicBlock *Pred : predecessors(BB)) {
+            if (!Members.contains(Pred) && DT.isReachableFromEntry(Pred))
+              EntryBlocks.insert(BB);
+          }
+        }
+        if (EntryBlocks.size() <= 1)
+          continue;
+
+        errs() << "cudavm: SPIR-V irreducible SCC stage=" << Stage
+               << " function=" << F.getName() << " members=" << SCC.size()
+               << " entries=" << EntryBlocks.size() << "\n";
+        for (BasicBlock *SCCEntry : EntryBlocks) {
+          errs() << "cudavm:   SCC entry=";
+          SCCEntry->printAsOperand(errs(), false);
+          if (SCCEntry->hasName())
+            errs() << " name=" << SCCEntry->getName();
+          errs() << "\n";
+        }
+      }
+    }
+
+    const char *IRFilterValue = std::getenv("CUDAVM_TRACE_SPIRV_IR");
+    bool TraceIR = false;
+    if (IRFilterValue != nullptr) {
+      StringRef Filter(IRFilterValue);
+      TraceIR = Filter.empty() || Filter == "1" || Filter == "all" ||
+                F.getName().contains(Filter);
+    }
+    if (TraceIR) {
+      errs() << "cudavm: SPIR-V IR begin stage=" << Stage
+             << " function=" << F.getName() << "\n";
+      F.print(errs());
+      errs() << "cudavm: SPIR-V IR end stage=" << Stage
+             << " function=" << F.getName() << "\n";
+    }
+    return false;
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+  }
+
+private:
+  std::string Stage;
+};
