.version 6.0
.target sm_50
.address_size 64

.visible .entry perf_vector_transform(.param .u64 input, .param .u64 output, .param .u32 count) {
    .reg .b64 %source, %destination, %offset;
    .reg .b32 %block, %threads, %lane, %index, %count, %value, %bias;
    .reg .pred %done;
    ld.param.u64 %source, [input];
    ld.param.u64 %destination, [output];
    ld.param.u32 %count, [count];
    mov.u32 %block, %ctaid.x;
    mov.u32 %threads, %ntid.x;
    mov.u32 %lane, %tid.x;
    mad.lo.u32 %index, %block, %threads, %lane;
    setp.ge.u32 %done, %index, %count;
    @%done bra finished;
    mul.wide.u32 %offset, %index, 4;
    add.u64 %source, %source, %offset;
    add.u64 %destination, %destination, %offset;
    ld.global.u32 %value, [%source];
    mul.lo.u32 %value, %value, 3;
    xor.b32 %bias, %index, 0x5a17c9e3;
    add.u32 %value, %value, %bias;
    st.global.u32 [%destination], %value;
finished:
    ret;
}
