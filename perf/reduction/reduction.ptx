.version 6.0
.target sm_50
.address_size 64

.visible .entry perf_reduce_blocks(.param .u64 input, .param .u64 output, .param .u32 count) {
    .shared .align 4 .b8 scratch[512];
    .reg .b64 %source, %destination, %shared, %own, %other, %offset;
    .reg .b32 %block, %width, %lane, %index, %count, %value, %rhs, %step, %peer;
    .reg .pred %condition;
    ld.param.u64 %source, [input];
    ld.param.u64 %destination, [output];
    ld.param.u32 %count, [count];
    mov.u32 %block, %ctaid.x;
    mov.u32 %width, %ntid.x;
    mov.u32 %lane, %tid.x;
    mad.lo.u32 %index, %block, %width, %lane;
    mov.u32 %value, 0;
    setp.ge.u32 %condition, %index, %count;
    @%condition bra initialized;
    mul.wide.u32 %offset, %index, 4;
    add.u64 %source, %source, %offset;
    ld.global.u32 %value, [%source];
initialized:
    mov.u64 %shared, scratch;
    mad.wide.u32 %own, %lane, 4, %shared;
    st.shared.u32 [%own], %value;
    bar.sync 0;
    mov.u32 %step, 64;
loop:
    setp.eq.u32 %condition, %step, 0;
    @%condition bra write;
    setp.ge.u32 %condition, %lane, %step;
    @%condition bra rendezvous;
    add.u32 %peer, %lane, %step;
    mad.wide.u32 %other, %peer, 4, %shared;
    ld.shared.u32 %value, [%own];
    ld.shared.u32 %rhs, [%other];
    add.u32 %value, %value, %rhs;
    st.shared.u32 [%own], %value;
rendezvous:
    bar.sync 0;
    shr.u32 %step, %step, 1;
    bra loop;
write:
    setp.ne.u32 %condition, %lane, 0;
    @%condition bra finished;
    ld.shared.u32 %value, [%own];
    mad.wide.u32 %destination, %block, 4, %destination;
    st.global.u32 [%destination], %value;
finished:
    ret;
}
