.version 6.0
.target sm_50
.address_size 64

.visible .entry perf_loaded_value(.param .u64 output, .param .u32 input) {
    .reg .b64 %pointer;
    .reg .b32 %value;
    ld.param.u64 %pointer, [output];
    ld.param.u32 %value, [input];
    xor.b32 %value, %value, 0x5a17c9e3;
    add.u32 %value, %value, 17;
    st.global.u32 [%pointer], %value;
    ret;
}
