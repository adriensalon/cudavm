cmake_minimum_required(VERSION 3.24)

function(_cudavm_record_provenance path value)
    string(REPLACE "\\" "\\\\" quoted "${value}")
    string(REPLACE "\"" "\\\"" quoted "${quoted}")
    string(REPLACE "\r" "\\r" quoted "${quoted}")
    string(REPLACE "\n" "\\n" quoted "${quoted}")
    string(JSON provenance SET "${provenance}" ${path} "\"${quoted}\"")
    set(provenance "${provenance}" PARENT_SCOPE)
endfunction()

foreach(argument toolkit work)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "Specify -D${argument}=... when regenerating the pinned NVIDIA client")
    endif()
endforeach()

if(NOT DEFINED cxx)
    find_program(cxx NAMES clang++ REQUIRED)
endif()

get_filename_component(toolkit "${toolkit}" ABSOLUTE)
set(fixture "${CMAKE_CURRENT_LIST_DIR}")
set(inputs "${fixture}/../kernel_launch")
set(header "${toolkit}/include/cuda.h")
set(library "${toolkit}/lib/x64/cuda.lib")
file(STRINGS "${header}" version REGEX "^#define CUDA_VERSION ")

if(NOT version MATCHES "12040$" OR NOT EXISTS "${library}")
    message(FATAL_ERROR "This producer requires genuine NVIDIA CUDA 12.4 headers and Driver import library")
endif()

if(NOT DEFINED ENV{VCToolsVersion} OR NOT DEFINED ENV{WindowsSDKVersion})
    message(FATAL_ERROR "Run in a Windows x64 Visual Studio C++ environment")
endif()

file(MAKE_DIRECTORY "${work}")
file(REAL_PATH "${work}" work)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${work}/driver_${nonce}")
cmake_path(IS_PREFIX work "${root}" NORMALIZE owned)

if(NOT owned OR root STREQUAL work OR EXISTS "${root}")
    message(FATAL_ERROR "Producer work must stay inside its new owned directory")
endif()

file(MAKE_DIRECTORY "${root}" "${fixture}/windows_x64")
file(READ "${inputs}/kernel_launch.ptx" ptx)
file(READ "${inputs}/kernel_launch.cubin" cubin HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," cubin "${cubin}")
file(WRITE "${root}/driver_images.hpp" "#pragma once\nstatic const char driver_ptx[] = R\"client_ptx(${ptx})client_ptx\";\nalignas(8) static const unsigned char driver_cubin[] = {${cubin}};\n")
set(output "${fixture}/windows_x64/driver_client.exe")
set(command "${cxx}" -std=c++17 -O2 -D_MT -Xclang --dependent-lib=libcmt
    "-I${toolkit}/include" "-I${root}" "${fixture}/driver_client.cpp" "${library}" -o "${output}" -Wl,/Brepro)
execute_process(COMMAND ${command} WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${cxx}" --version OUTPUT_VARIABLE compiler_version COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCH "^[^\r\n]+" compiler_version "${compiler_version}")
set(provenance [[{"platform":"windows-x86_64","runtime_linkage":"none (Driver-only client)","header_version":"CUDA 12.4","minimum_driver_api":12000,"import_library":"NVIDIA CUDA 12.4 lib/x64/cuda.lib","generator":"produce.cmake","command":[],"sha256":{},"producer_sha256":{}}]])

_cudavm_record_provenance(host_compiler "${compiler_version}")
_cudavm_record_provenance(host_crt "Microsoft static release CRT, Visual C++ tools $ENV{VCToolsVersion}")
_cudavm_record_provenance(windows_sdk "$ENV{WindowsSDKVersion}")
_cudavm_record_provenance(gpu_images "Embedded unmodified kernel_launch PTX and NVIDIA ptxas SM75 cubin; see ../kernel_launch/provenance.json")
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" generator_hash)
_cudavm_record_provenance(generator_sha256 "${generator_hash}")
set(index 0)

foreach(argument IN LISTS command)
    string(REPLACE "${toolkit}" "<NVIDIA-toolkit>" argument "${argument}")
    string(REPLACE "${fixture}" "<fixture>" argument "${argument}")
    string(REPLACE "${root}" "<generated-images>" argument "${argument}")
    _cudavm_record_provenance("command;${index}" "${argument}")
    math(EXPR index "${index} + 1")
endforeach()

foreach(name driver_client.cpp windows_x64/driver_client.exe ../kernel_launch/kernel_launch.ptx ../kernel_launch/kernel_launch.cubin)
    file(SHA256 "${fixture}/${name}" digest)
    _cudavm_record_provenance("sha256;${name}" "${digest}")
endforeach()

foreach(name include/cuda.h lib/x64/cuda.lib)
    file(SHA256 "${toolkit}/${name}" digest)
    _cudavm_record_provenance("producer_sha256;${name}" "${digest}")
endforeach()

file(WRITE "${fixture}/provenance.json" "${provenance}\n")
file(REAL_PATH "${root}" resolved_root)
cmake_path(IS_PREFIX work "${resolved_root}" NORMALIZE owned)

if(NOT owned OR resolved_root STREQUAL work OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "Refusing cleanup outside the producer's work directory")
endif()

file(REMOVE_RECURSE "${resolved_root}")
