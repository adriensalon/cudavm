.version 6.5
.target sm_75
.address_size 64

.visible .entry update_write(.param .u64 output, .param .u32 count, .param .u32 value) {
 .reg .b64 %pointer;
 .reg .b32 %i, %block, %threads, %count, %value;
 .reg .pred %valid;
 mov.u32 %i, %tid.x; mov.u32 %block, %ctaid.x; mov.u32 %threads, %ntid.x;
 mad.lo.u32 %i, %block, %threads, %i;
 ld.param.u32 %count, [count];
 setp.lt.u32 %valid, %i, %count; @!%valid ret;
 ld.param.u64 %pointer, [output]; ld.param.u32 %value, [value];
 mad.wide.u32 %pointer, %i, 4, %pointer;
 mad.lo.u32 %value, %i, 7, %value;
 st.global.u32 [%pointer], %value; ret;
}
.visible .entry update_twist(.param .u64 output, .param .u32 count, .param .u32 value) {
 .reg .b64 %pointer;
 .reg .b32 %i, %block, %threads, %count, %value, %rank;
 .reg .pred %valid;
 mov.u32 %i, %tid.x; mov.u32 %block, %ctaid.x; mov.u32 %threads, %ntid.x;
 mad.lo.u32 %i, %block, %threads, %i;
 ld.param.u32 %count, [count];
 setp.lt.u32 %valid, %i, %count; @!%valid ret;
 ld.param.u64 %pointer, [output]; ld.param.u32 %value, [value];
 mad.wide.u32 %pointer, %i, 4, %pointer;
 mad.lo.u32 %rank, %i, 13, 0xa5a55a5a;
 xor.b32 %value, %value, %rank;
 st.global.u32 [%pointer], %value; ret;
}
