.version 6.5
.target sm_75
.address_size 64

.visible .entry replay_step(.param .u64 state, .param .u32 count, .param .u32 add) {
 .reg .b64 %pointer;
 .reg .b32 %i, %block, %threads, %limit, %add, %value;
 .reg .pred %valid;
 mov.u32 %i, %tid.x; mov.u32 %block, %ctaid.x; mov.u32 %threads, %ntid.x;
 mad.lo.u32 %i, %block, %threads, %i;
 ld.param.u32 %limit, [count]; setp.lt.u32 %valid, %i, %limit; @!%valid ret;
 ld.param.u64 %pointer, [state]; ld.param.u32 %add, [add];
 mad.wide.u32 %pointer, %i, 4, %pointer;
 ld.global.u32 %value, [%pointer];
 mad.lo.u32 %value, %value, 3, %add;
 mad.lo.u32 %value, %i, 7, %value;
 st.global.u32 [%pointer], %value; ret;
}
