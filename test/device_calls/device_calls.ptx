// Independently authored PTX 6.5 with mixed-width call parameters/results.
.version 6.5
.target sm_75
.address_size 64
.func (.param .u64 result) mix_words(.param .u64 a, .param .u64 b, .param .u32 shift) {
 .reg .b64 %a, %b, %left, %right;
 .reg .b32 %shift, %other;
 ld.param.u64 %a, [a]; ld.param.u64 %b, [b]; ld.param.u32 %shift, [shift];
 and.b32 %shift, %shift, 63; sub.u32 %other, 0, %shift; and.b32 %other, %other, 63;
 shl.b64 %left, %a, %shift; shr.u64 %right, %a, %other;
 or.b64 %a, %left, %right; add.u64 %a, %a, %b; st.param.u64 [result], %a; ret;
}
.func (.param .u32 result) fold_words(.param .u32 a, .param .u32 b) {
 .reg .b32 %a, %b, %value; .reg .pred %high;
 ld.param.u32 %a, [a]; ld.param.u32 %b, [b]; mul.lo.u32 %b, %b, 33; xor.b32 %value, %a, %b;
 setp.lt.s32 %high, %value, 0; @%high bra negative;
 add.u32 %value, %value, 0x89abcdef; st.param.u32 [result], %value; ret;
negative:
 sub.u32 %value, %value, 0x13579bdf; st.param.u32 [result], %value; ret;
}
.func (.param .u64 result) nested_words(.param .u64 a, .param .u64 b, .param .u32 rounds) {
 .reg .b64 %a, %b, %next_b, %wide, %low;
 .reg .b32 %rounds, %round, %shift, %lo, %hi, %folded; .reg .pred %p;
 .param .u64 arg_a, arg_b, mixed;
 .param .u32 arg_shift, arg_lo, arg_hi, folded;
 ld.param.u64 %a, [a]; ld.param.u64 %b, [b]; ld.param.u32 %rounds, [rounds]; mov.u32 %round, 0;
again:
 setp.ge.u32 %p, %round, %rounds; @%p bra done;
 cvt.u64.u32 %wide, %round; add.u64 %next_b, %b, %wide; mul.lo.u32 %shift, %round, 7;
 st.param.u64 [arg_a], %a; st.param.u64 [arg_b], %next_b; st.param.u32 [arg_shift], %shift;
 call (mixed), mix_words, (arg_a, arg_b, arg_shift); ld.param.u64 %a, [mixed];
 cvt.u32.u64 %lo, %a; shr.u64 %wide, %a, 32; cvt.u32.u64 %hi, %wide;
 st.param.u32 [arg_lo], %lo; st.param.u32 [arg_hi], %hi;
 call (folded), fold_words, (arg_lo, arg_hi); ld.param.u32 %folded, [folded];
 cvt.u64.u32 %wide, %folded; shl.b64 %low, %wide, 32; or.b64 %wide, %wide, %low;
 xor.b64 %a, %a, %wide; add.u32 %round, %round, 1; bra again;
done:
 st.param.u64 [result], %a; ret;
}
.visible .entry call_results(.param .u64 out, .param .u64 in, .param .u32 count, .param .u32 rounds) {
 .reg .b32 %i, %block, %threads, %count, %rounds, %lo, %hi, %folded, %branch, %which;
 .reg .b64 %out, %in, %a, %b, %mixed, %nested, %wide; .reg .pred %p;
 .param .u64 arg_a, arg_b, mixed, nested;
 .param .u32 arg_shift, arg_rounds, arg_lo, arg_hi, folded, branch;
 mov.u32 %i, %tid.x; mov.u32 %block, %ctaid.x; mov.u32 %threads, %ntid.x;
 mad.lo.u32 %i, %block, %threads, %i; ld.param.u32 %count, [count]; setp.ge.u32 %p, %i, %count; @%p ret;
 ld.param.u64 %out, [out]; ld.param.u64 %in, [in]; ld.param.u32 %rounds, [rounds];
 mad.wide.u32 %in, %i, 16, %in; ld.global.u64 %a, [%in]; ld.global.u64 %b, [%in+8];
 st.param.u64 [arg_a], %a; st.param.u64 [arg_b], %b; st.param.u32 [arg_shift], %i;
 call (mixed), mix_words, (arg_a, arg_b, arg_shift); ld.param.u64 %mixed, [mixed];
 cvt.u32.u64 %lo, %mixed; shr.u64 %wide, %mixed, 32; cvt.u32.u64 %hi, %wide;
 st.param.u32 [arg_lo], %lo; st.param.u32 [arg_hi], %hi;
 call (folded), fold_words, (arg_lo, arg_hi); ld.param.u32 %folded, [folded];
 and.b32 %which, %i, 3; add.u32 %rounds, %rounds, %which;
 st.param.u64 [arg_a], %a; st.param.u64 [arg_b], %b; st.param.u32 [arg_rounds], %rounds;
 call (nested), nested_words, (arg_a, arg_b, arg_rounds); ld.param.u64 %nested, [nested];
 and.b32 %which, %i, 1; setp.ne.u32 %p, %which, 0; @%p bra odd;
 shr.u64 %wide, %b, 32; cvt.u32.u64 %lo, %wide; shr.u64 %wide, %a, 32; cvt.u32.u64 %hi, %wide;
 st.param.u32 [arg_lo], %lo; st.param.u32 [arg_hi], %hi;
 call (branch), fold_words, (arg_lo, arg_hi); ld.param.u32 %branch, [branch]; bra write;
odd:
 cvt.u32.u64 %lo, %a; cvt.u32.u64 %hi, %b;
 st.param.u32 [arg_lo], %lo; st.param.u32 [arg_hi], %hi;
 call (branch), fold_words, (arg_lo, arg_hi); ld.param.u32 %branch, [branch];
write:
 mad.wide.u32 %out, %i, 24, %out;
 cvt.u32.u64 %lo, %mixed; shr.u64 %wide, %mixed, 32; cvt.u32.u64 %hi, %wide;
 st.global.u32 [%out], %lo; st.global.u32 [%out+4], %hi; st.global.u32 [%out+8], %folded;
 cvt.u32.u64 %lo, %nested; shr.u64 %wide, %nested, 32; cvt.u32.u64 %hi, %wide;
 st.global.u32 [%out+12], %lo; st.global.u32 [%out+16], %hi; st.global.u32 [%out+20], %branch; ret;
}
