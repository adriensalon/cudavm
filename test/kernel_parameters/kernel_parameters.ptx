// Independently authored PTX: explicit parameter offsets and aggregate alignment.
.version 6.5
.target sm_75
.address_size 64
.visible .entry parameter_layout(
 .param .u64 out, .param .u8 marker,
 .param .align 16 .b8 record[32], .param .u16 bias,
 .param .align 16 .b8 vector[16], .param .u64 salt, .param .u32 count) {
 .reg .b64 %out,%wide,%salt,%sum,%offset;
 .reg .b32 %i,%block,%threads,%count,%value,%other;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %out,[out]; mad.wide.u32 %out,%i,68,%out;
 ld.param.u8 %value,[marker]; st.global.u32 [%out],%value;
 ld.param.u16 %value,[record+4]; ld.param.u16 %other,[bias];
 add.u32 %value,%value,%other; st.global.u32 [%out+4],%value;
 ld.param.u8 %value,[record+6]; st.global.u32 [%out+8],%value;
 ld.param.u8 %value,[record+7]; st.global.u32 [%out+12],%value;
 ld.param.u32 %value,[record]; xor.b32 %value,%value,%i; st.global.u32 [%out+16],%value;
 ld.param.u64 %wide,[record+8];
 mov.b64 {%value,%other},%wide;
 st.global.u32 [%out+20],%value; st.global.u32 [%out+24],%other;
 ld.param.u32 %value,[record+16]; add.u32 %value,%value,%i; st.global.u32 [%out+28],%value;
 ld.param.u32 %value,[record+20]; xor.b32 %value,%value,%i; st.global.u32 [%out+32],%value;
 ld.param.u32 %value,[record+24]; sub.u32 %value,%value,%i; st.global.u32 [%out+36],%value;
 ld.param.u32 %value,[record+28]; st.global.u32 [%out+40],%value;
 ld.param.u32 %value,[vector]; st.global.u32 [%out+44],%value;
 ld.param.u32 %value,[vector+4]; st.global.u32 [%out+48],%value;
 ld.param.u32 %value,[vector+8]; st.global.u32 [%out+52],%value;
 ld.param.u32 %value,[vector+12]; st.global.u32 [%out+56],%value;
 ld.param.u64 %salt,[salt]; cvt.u64.u32 %offset,%i;
 add.u64 %sum,%wide,%salt; add.u64 %sum,%sum,%offset;
 mov.b64 {%value,%other},%sum;
 st.global.u32 [%out+60],%value; st.global.u32 [%out+64],%other;
 ret;
}
