// Independently authored PTX with explicit comparison and classification instructions.
.version 6.5
.target sm_75
.address_size 64
.visible .entry compare_float(.param .u64 out,.param .u64 in,.param .u32 count) {
 .reg .b64 %out,%in;
 .reg .b32 %i,%block,%threads,%count,%value;
 .reg .f32 %a,%b,%result;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in];
 mad.wide.u32 %out,%i,96,%out; mad.wide.u32 %in,%i,8,%in;
 ld.global.f32 %a,[%in]; ld.global.f32 %b,[%in+4];
 setp.eq.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+0],%value;
 setp.neu.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+4],%value;
 setp.lt.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+8],%value;
 setp.le.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+12],%value;
 setp.gt.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+16],%value;
 setp.ge.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+20],%value;
 setp.ltu.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+24],%value;
 setp.leu.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+28],%value;
 setp.gtu.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+32],%value;
 setp.geu.f32 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+36],%value;
 testp.notanumber.f32 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+40],%value;
 testp.infinite.f32 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+44],%value;
 testp.finite.f32 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+48],%value;
 testp.normal.f32 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+80],%value;
 testp.subnormal.f32 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+84],%value;
 mov.b32 %value,%a; shr.u32 %value,%value,31; st.global.u32 [%out+52],%value;
 min.f32 %result,%a,%b; st.global.f32 [%out+56],%result;
 max.f32 %result,%a,%b; st.global.f32 [%out+60],%result;
 abs.f32 %result,%a; st.global.f32 [%out+64],%result;
 copysign.f32 %result,%b,%a; st.global.f32 [%out+68],%result;
 min.f32 %result,%a,%b; st.global.f32 [%out+72],%result;
 max.f32 %result,%a,%b; st.global.f32 [%out+76],%result;
 min.f32 %result,%a,%b; st.global.f32 [%out+88],%result;
 max.f32 %result,%a,%b; st.global.f32 [%out+92],%result;
 ret;
}
