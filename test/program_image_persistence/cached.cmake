cmake_minimum_required(VERSION 3.24)
foreach(argument producer loader backend work)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "Missing cached-image argument: ${argument}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${work}")
file(REAL_PATH "${work}" work_root)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${work_root}/cached-${backend}-${nonce}")
cmake_path(IS_PREFIX work_root "${root}" NORMALIZE owned)
if(NOT owned OR root STREQUAL work_root)
    message(FATAL_ERROR "Cache process directory must be a child of its owned test directory")
endif()
set(isolated "${root}/loader")
file(MAKE_DIRECTORY "${isolated}")
execute_process(COMMAND "${producer}" --cache-files "${root}"
    RESULT_VARIABLE produced OUTPUT_VARIABLE producer_output ERROR_VARIABLE producer_error TIMEOUT 60)
if(NOT produced STREQUAL "0")
    message(FATAL_ERROR "Public cache producer failed: ${produced}\n${producer_output}\n${producer_error}")
endif()
get_filename_component(loader_directory "${loader}" DIRECTORY)
get_filename_component(loader_name "${loader}" NAME)
file(COPY_FILE "${loader}" "${isolated}/${loader_name}")
# Copy native ingestion dependencies, excluding compiler facades and core.
# cwd and loader search paths below also exclude the original build/SDK.
file(GLOB dependencies LIST_DIRECTORIES FALSE "${loader_directory}/*.dll" "${loader_directory}/*.so*" "${loader_directory}/*.dylib")
foreach(dependency IN LISTS dependencies)
    get_filename_component(name "${dependency}" NAME)
    string(TOLOWER "${name}" folded)
    if(NOT folded MATCHES "^(lib)?cudavm_(core|nvrtc|nvvm|nvjitlink|nvptxcompiler|nvfatbin)")
        file(COPY_FILE "${dependency}" "${isolated}/${name}")
    endif()
endforeach()
if(WIN32)
    set(ENV{PATH} "${isolated};$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
else()
    set(ENV{LD_LIBRARY_PATH} "${isolated}")
    set(ENV{DYLD_LIBRARY_PATH} "${isolated}")
    set(ENV{DYLD_FALLBACK_LIBRARY_PATH} "${isolated}:/usr/lib:/usr/local/lib")
endif()
set(ENV{CUDAVM_BACKENDS} "${backend}")
execute_process(COMMAND "${isolated}/${loader_name}" "${backend}" "${root}"
    WORKING_DIRECTORY "${isolated}" RESULT_VARIABLE loaded
    OUTPUT_VARIABLE loader_output ERROR_VARIABLE loader_error TIMEOUT 120)
message("${producer_output}${producer_error}${loader_output}${loader_error}")
if(loaded STREQUAL "77")
    message("SKIP: isolated cached-image backend is unavailable")
elseif(NOT loaded STREQUAL "0")
    message(FATAL_ERROR "Compiler-free cache loader failed: ${loaded}")
endif()
# Keep failure evidence; successful and unavailable cases retire only the
# absolute generated child checked against the owned work directory above.
file(REMOVE_RECURSE "${root}")
