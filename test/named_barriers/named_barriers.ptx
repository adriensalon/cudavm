// Independently authored PTX 6.5; counted groups contain complete warps.
.version 6.5
.target sm_75
.address_size 64
.visible .entry named_whole(.param .u64 out, .param .u64 in, .param .u64 scratch,
 .param .u32 rounds, .param .u32 id, .param .u32 pattern) {
 .shared .align 4 .b8 values[512];
 .reg .b64 %out,%in,%scratch,%shared,%own,%global,%address;
 .reg .b32 %lane,%threads,%block,%base,%i,%rounds,%id,%pattern,%round,%input,%value,
   %peer,%index,%temp,%shared_sum,%global_sum,%votes,%every,%any,%n,%a,%o;
 .reg .pred %p,%truth,%all,%some;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in]; ld.param.u64 %scratch,[scratch];
 ld.param.u32 %rounds,[rounds]; ld.param.u32 %id,[id]; ld.param.u32 %pattern,[pattern];
 mov.u32 %lane,%tid.x; mov.u32 %threads,%ntid.x; mov.u32 %block,%ctaid.x;
 mul.lo.u32 %base,%block,%threads; add.u32 %i,%base,%lane;
 mad.wide.u32 %in,%i,4,%in; ld.global.u32 %input,[%in];
 mov.u64 %shared,values; mad.wide.u32 %own,%lane,4,%shared;
 mad.wide.u32 %global,%i,4,%scratch;
 mov.u32 %round,0; mov.u32 %shared_sum,0; mov.u32 %global_sum,0;
 mov.u32 %votes,0; mov.u32 %every,0; mov.u32 %any,0;
loop:
 setp.ge.u32 %p,%round,%rounds; @%p bra done;
 mad.lo.u32 %value,%round,17,%i; xor.b32 %value,%input,%value;
 st.shared.u32 [%own],%value; add.u32 %value,%value,0x12345; st.global.u32 [%global],%value;
 setp.eq.u32 %p,%id,0; @%p bra publish_0;
 setp.eq.u32 %p,%id,1; @%p bra publish_1;
 setp.eq.u32 %p,%id,7; @%p bra publish_7;
 barrier.sync 15; bra publish_done;
publish_0:
 barrier.sync 0; bra publish_done;
publish_1:
 barrier.sync 1; bra publish_done;
publish_7:
 barrier.sync 7; bra publish_done;
publish_done:
 add.u32 %peer,%lane,%round; add.u32 %peer,%peer,1; rem.u32 %peer,%peer,%threads;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 add.u32 %shared_sum,%shared_sum,%value;
 add.u32 %index,%base,%peer; mad.wide.u32 %address,%index,4,%scratch;
 ld.global.u32 %value,[%address]; add.u32 %global_sum,%global_sum,%value;
 setp.eq.u32 %p,%id,0; @%p bra reuse_0;
 setp.eq.u32 %p,%id,1; @%p bra reuse_1;
 setp.eq.u32 %p,%id,7; @%p bra reuse_7;
 barrier.sync 15; bra reuse_done;
reuse_0:
 barrier.sync 0; bra reuse_done;
reuse_1:
 barrier.sync 1; bra reuse_done;
reuse_7:
 barrier.sync 7; bra reuse_done;
reuse_done:
 add.u32 %round,%round,1; bra loop;
done:
 mad.wide.u32 %out,%i,20,%out;
 st.global.u32 [%out],%shared_sum; st.global.u32 [%out+4],%global_sum;
 st.global.u32 [%out+8],%votes; st.global.u32 [%out+12],%every; st.global.u32 [%out+16],%any;
 ret;
}
.visible .entry named_groups(.param .u64 out, .param .u64 in, .param .u64 scratch,
 .param .u32 rounds, .param .u32 id, .param .u32 pattern) {
 .shared .align 4 .b8 values[512];
 .reg .b64 %out,%in,%scratch,%shared,%own,%global,%address;
 .reg .b32 %lane,%threads,%block,%base,%i,%rounds,%id,%pattern,%round,%input,%value,
   %peer,%index,%temp,%shared_sum,%global_sum,%votes,%every,%any,%n,%a,%o;
 .reg .pred %p,%truth,%all,%some;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in]; ld.param.u64 %scratch,[scratch];
 ld.param.u32 %rounds,[rounds]; ld.param.u32 %id,[id]; ld.param.u32 %pattern,[pattern];
 mov.u32 %lane,%tid.x; mov.u32 %threads,%ntid.x; mov.u32 %block,%ctaid.x;
 mul.lo.u32 %base,%block,%threads; add.u32 %i,%base,%lane;
 mad.wide.u32 %in,%i,4,%in; ld.global.u32 %input,[%in];
 mov.u64 %shared,values; mad.wide.u32 %own,%lane,4,%shared;
 mad.wide.u32 %global,%i,4,%scratch;
 mov.u32 %round,0; mov.u32 %shared_sum,0; mov.u32 %global_sum,0;
 mov.u32 %votes,0; mov.u32 %every,0; mov.u32 %any,0;
loop:
 setp.ge.u32 %p,%round,%rounds; @%p bra done;
 mad.lo.u32 %value,%round,17,%i; xor.b32 %value,%input,%value;
 st.shared.u32 [%own],%value; add.u32 %value,%value,0x12345; st.global.u32 [%global],%value;
 setp.ne.u32 %truth,%pattern,0;
 setp.eq.u32 %p,%pattern,0; @%p bra vote;
 setp.eq.u32 %p,%pattern,1; @%p bra vote;
 setp.eq.u32 %p,%pattern,2; @!%p bra mixed;
 and.b32 %temp,%round,63; and.b32 %peer,%lane,63; setp.eq.u32 %truth,%peer,%temp; bra vote;
mixed:
 add.u32 %temp,%input,%round; and.b32 %temp,%temp,3; setp.ne.u32 %truth,%temp,0;
vote:
 setp.lt.u32 %p,%lane,64; @%p bra first_group;
 barrier.red.popc.u32 %n,15,64,%truth;
 barrier.red.and.pred %all,15,64,%truth;
 barrier.red.or.pred %some,15,64,%truth; bra voted;
first_group:
 barrier.red.popc.u32 %n,1,64,%truth;
 barrier.red.and.pred %all,1,64,%truth;
 barrier.red.or.pred %some,1,64,%truth;
voted:
 selp.u32 %a,1,0,%all; selp.u32 %o,1,0,%some;
 add.u32 %votes,%votes,%n; add.u32 %every,%every,%a; add.u32 %any,%any,%o;
 add.u32 %peer,%lane,%round; add.u32 %peer,%peer,1; and.b32 %peer,%peer,63;
 and.b32 %temp,%lane,64; add.u32 %peer,%peer,%temp;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 add.u32 %shared_sum,%shared_sum,%value;
 add.u32 %index,%base,%peer; mad.wide.u32 %address,%index,4,%scratch;
 ld.global.u32 %value,[%address]; add.u32 %global_sum,%global_sum,%value;
 setp.lt.u32 %p,%lane,64; @%p bra reuse_first;
 barrier.sync 15,64; bra reused;
reuse_first:
 barrier.sync 1,64;
reused:
 add.u32 %round,%round,1; bra loop;
done:
 mad.wide.u32 %out,%i,20,%out;
 st.global.u32 [%out],%shared_sum; st.global.u32 [%out+4],%global_sum;
 st.global.u32 [%out+8],%votes; st.global.u32 [%out+12],%every; st.global.u32 [%out+16],%any;
 ret;
}
.visible .entry named_handoff(.param .u64 out, .param .u64 in, .param .u64 scratch,
 .param .u32 rounds, .param .u32 id, .param .u32 pattern) {
 .shared .align 4 .b8 values[512];
 .reg .b64 %out,%in,%scratch,%shared,%own,%global,%address;
 .reg .b32 %lane,%threads,%block,%base,%i,%rounds,%id,%pattern,%round,%input,%value,
   %peer,%index,%temp,%shared_sum,%global_sum,%votes,%every,%any,%n,%a,%o;
 .reg .pred %p,%truth,%all,%some;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in]; ld.param.u64 %scratch,[scratch];
 ld.param.u32 %rounds,[rounds]; ld.param.u32 %id,[id]; ld.param.u32 %pattern,[pattern];
 mov.u32 %lane,%tid.x; mov.u32 %threads,%ntid.x; mov.u32 %block,%ctaid.x;
 mul.lo.u32 %base,%block,%threads; add.u32 %i,%base,%lane;
 mad.wide.u32 %in,%i,4,%in; ld.global.u32 %input,[%in];
 mov.u64 %shared,values; mad.wide.u32 %own,%lane,4,%shared;
 mad.wide.u32 %global,%i,4,%scratch;
 mov.u32 %round,0; mov.u32 %shared_sum,0; mov.u32 %global_sum,0;
 mov.u32 %votes,0; mov.u32 %every,0; mov.u32 %any,0;
loop:
 setp.ge.u32 %p,%round,%rounds; @%p bra done;
 setp.ge.u32 %p,%lane,64; @%p bra independent;
 setp.ge.u32 %p,%lane,32; @%p bra consumer;
 mad.lo.u32 %value,%round,17,%i; xor.b32 %value,%input,%value;
 st.shared.u32 [%own],%value; add.u32 %value,%value,0x12345; st.global.u32 [%global],%value;
 barrier.arrive 1,64; barrier.sync 2,64; barrier.sync 3,64; bra reused;
consumer:
 barrier.sync 2,64; barrier.sync 1,64;
 add.u32 %peer,%lane,%round; add.u32 %peer,%peer,1; and.b32 %peer,%peer,31;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 add.u32 %shared_sum,%shared_sum,%value;
 add.u32 %index,%base,%peer; mad.wide.u32 %address,%index,4,%scratch;
 ld.global.u32 %value,[%address]; add.u32 %global_sum,%global_sum,%value;
 barrier.arrive 3,64; bra reused;
independent:
 mad.lo.u32 %value,%round,17,%i; xor.b32 %value,%input,%value;
 st.shared.u32 [%own],%value; add.u32 %value,%value,0x12345; st.global.u32 [%global],%value;
 barrier.sync 15,64;
 add.u32 %peer,%lane,%round; add.u32 %peer,%peer,1; and.b32 %peer,%peer,63; add.u32 %peer,%peer,64;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 add.u32 %shared_sum,%shared_sum,%value;
 add.u32 %index,%base,%peer; mad.wide.u32 %address,%index,4,%scratch;
 ld.global.u32 %value,[%address]; add.u32 %global_sum,%global_sum,%value;
 barrier.sync 15,64;
reused:
 add.u32 %round,%round,1; bra loop;
done:
 mad.wide.u32 %out,%i,20,%out;
 st.global.u32 [%out],%shared_sum; st.global.u32 [%out+4],%global_sum;
 st.global.u32 [%out+8],%votes; st.global.u32 [%out+12],%every; st.global.u32 [%out+16],%any;
 ret;
}
