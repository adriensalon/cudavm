 ld.param.u64 %rd,[out]; ld.param.u32 %r0,[add];
 ld.global.u32 %r1,[seed]; ld.const.u32 %r2,[bias];
 add.u32 %r3,%r1,%r2; add.u32 %r4,%r3,%r0;
 add.u32 %r4,%r4,6; st.global.u32 [%rd],%r4; ret;
}
