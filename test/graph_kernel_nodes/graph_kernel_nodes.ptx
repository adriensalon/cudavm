.version 6.5
.target sm_75
.address_size 64
.extern .shared .align 4 .b8 values[];

.visible .entry kernel_node_write(.param .u64 output, .param .u32 count, .param .u32 seed) {
 .reg .b32 %tx, %ty, %tz, %nx, %ny, %nz, %bx, %by, %bz, %gx, %gy;
 .reg .b32 %lane, %threads, %block, %i, %count, %value, %peer;
 .reg .b64 %output, %shared, %address;
 .reg .pred %valid;
 mov.u32 %tx,%tid.x; mov.u32 %ty,%tid.y; mov.u32 %tz,%tid.z;
 mov.u32 %nx,%ntid.x; mov.u32 %ny,%ntid.y; mov.u32 %nz,%ntid.z;
 mov.u32 %bx,%ctaid.x; mov.u32 %by,%ctaid.y; mov.u32 %bz,%ctaid.z;
 mov.u32 %gx,%nctaid.x; mov.u32 %gy,%nctaid.y;
 mad.lo.u32 %lane,%tz,%ny,%ty; mad.lo.u32 %lane,%lane,%nx,%tx;
 mul.lo.u32 %threads,%nx,%ny; mul.lo.u32 %threads,%threads,%nz;
 mad.lo.u32 %block,%bz,%gy,%by; mad.lo.u32 %block,%block,%gx,%bx;
 mad.lo.u32 %i,%block,%threads,%lane;
 ld.param.u32 %value,[seed];
 mad.lo.u32 %value,%tx,3,%value; mad.lo.u32 %value,%ty,5,%value; mad.lo.u32 %value,%tz,7,%value;
 mad.lo.u32 %value,%bx,11,%value; mad.lo.u32 %value,%by,13,%value; mad.lo.u32 %value,%bz,17,%value;
 mad.lo.u32 %value,%nx,19,%value; mad.lo.u32 %value,%ny,23,%value; mad.lo.u32 %value,%nz,29,%value;
 mov.u64 %shared,values; mad.wide.u32 %address,%lane,4,%shared;
 st.shared.u32 [%address],%value; bar.sync 0;
 ld.param.u32 %count,[count]; setp.lt.u32 %valid,%i,%count; @!%valid ret;
 sub.u32 %peer,%threads,1; sub.u32 %peer,%peer,%lane;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 ld.param.u64 %output,[output]; mad.wide.u32 %address,%i,4,%output;
 st.global.u32 [%address],%value; ret;
}
