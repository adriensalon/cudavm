cmake_minimum_required(VERSION 3.24)
include("${settings}")
if(NOT mode MATCHES "^(shared|static)$")
    message(FATAL_ERROR "Expected shared or static SDK linkage")
endif()
function(sdk_run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 240)
    file(APPEND "${work}/commands.log" "Command: ${ARGV}\n${output}\n${error}\n")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "SDK command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
set(work "${sdk_work}/${mode}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/commands.log" "")
set(prefix "${sdk_existing_prefix}")
if(sdk_source_build)
    set(prefix "${work}/sdk")
    sdk_run("${CMAKE_COMMAND}" --install "${sdk_source_build}" --prefix "${prefix}" --config "${config}")
endif()
if(NOT EXISTS "${prefix}/lib/cmake/cudavm/cudavmConfig.cmake")
    message(FATAL_ERROR "Selected SDK has no installed CMake package: ${prefix}")
endif()
file(COPY "${sdk_fixture}/" DESTINATION "${work}/project")
set(generator_options -G "${sdk_generator}")
if(sdk_platform)
    list(APPEND generator_options -A "${sdk_platform}")
endif()
if(sdk_toolset)
    list(APPEND generator_options -T "${sdk_toolset}")
endif()
if(sdk_make_program)
    list(APPEND generator_options "-DCMAKE_MAKE_PROGRAM=${sdk_make_program}")
endif()
if(sdk_c)
    list(APPEND generator_options "-DCMAKE_C_COMPILER=${sdk_c}")
endif()
sdk_run("${CMAKE_COMMAND}" -S "${work}/project" -B "${work}/build" ${generator_options}
    "-DCMAKE_CXX_COMPILER=${sdk_cxx}" "-DCMAKE_BUILD_TYPE=${config}"
    "-DSDK_PREFIX=${prefix}" "-Dcudavm_DIR=${prefix}/lib/cmake/cudavm" "-DSDK_LINKAGE=${mode}")
sdk_run("${CMAKE_COMMAND}" --build "${work}/build" --config "${config}" --parallel 2)
sdk_run("${sdk_ctest}" --test-dir "${work}/build" -C "${config}" --output-on-failure)
message(STATUS "Installed ${mode} SDK consumer passed")
