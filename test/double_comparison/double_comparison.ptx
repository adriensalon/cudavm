// Independently authored PTX with binary64 and mixed binary32/binary64 operands.
.version 6.5
.target sm_75
.address_size 64
.visible .entry compare_double(.param .u64 out,.param .u64 in,.param .u32 count) {
 .reg .b64 %out,%in,%bits;
 .reg .b32 %i,%block,%threads,%count,%value,%low,%high;
 .reg .f64 %a,%b,%c,%result;
 .reg .f32 %f;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in];
 mad.wide.u32 %out,%i,176,%out; mad.wide.u32 %in,%i,24,%in;
 ld.global.f64 %a,[%in]; ld.global.f64 %b,[%in+8]; ld.global.f32 %f,[%in+16];
 cvt.f64.f32 %c,%f;
 setp.eq.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+0],%value;
 setp.neu.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+4],%value;
 setp.lt.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+8],%value;
 setp.le.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+12],%value;
 setp.gt.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+16],%value;
 setp.ge.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+20],%value;
 setp.ltu.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+24],%value;
 setp.leu.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+28],%value;
 setp.gtu.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+32],%value;
 setp.geu.f64 %p,%a,%b; selp.u32 %value,1,0,%p; st.global.u32 [%out+36],%value;
 testp.notanumber.f64 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+40],%value;
 testp.infinite.f64 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+44],%value;
 testp.finite.f64 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+48],%value;
 testp.normal.f64 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+120],%value;
 testp.subnormal.f64 %p,%a; selp.u32 %value,1,0,%p; st.global.u32 [%out+124],%value;
 mov.b64 {%low,%high},%a; shr.u32 %value,%high,31; st.global.u32 [%out+52],%value;
 min.f64 %result,%a,%b; st.global.f64 [%out+56],%result;
 max.f64 %result,%a,%b; st.global.f64 [%out+64],%result;
 abs.f64 %result,%a; st.global.f64 [%out+72],%result;
 copysign.f64 %result,%b,%a; st.global.f64 [%out+80],%result;
 min.f64 %result,%a,%b; st.global.f64 [%out+88],%result;
 max.f64 %result,%a,%b; st.global.f64 [%out+96],%result;
 min.f64 %result,%a,%b; st.global.f64 [%out+104],%result;
 max.f64 %result,%a,%b; st.global.f64 [%out+112],%result;
 min.f64 %result,%a,%c; st.global.f64 [%out+128],%result;
 min.f64 %result,%c,%a; st.global.f64 [%out+136],%result;
 max.f64 %result,%a,%c; st.global.f64 [%out+144],%result;
 max.f64 %result,%c,%a; st.global.f64 [%out+152],%result;
 abs.f64 %result,%a; st.global.f64 [%out+160],%result;
 copysign.f64 %result,%b,%a; st.global.f64 [%out+168],%result;
 ret;
}
