// Independently authored PTX, including naturally aligned mapped global access.
.version 6.5
.target sm_75
.address_size 64
.visible .entry mapped_host_transform(.param .u64 out, .param .u64 in, .param .u32 count, .param .u32 seed) {
 .reg .b64 %a,%b;
 .reg .b32 %i,%block,%threads,%count,%seed,%value,%mask;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %a,[out]; ld.param.u64 %b,[in]; ld.param.u32 %seed,[seed];
 mad.wide.u32 %a,%i,4,%a; mad.wide.u32 %b,%i,4,%b;
 ld.global.u32 %value,[%b]; mad.lo.u32 %mask,%i,17,%seed;
 xor.b32 %value,%value,%mask; add.u32 %value,%value,%i;
 st.global.u32 [%a],%value;
 ret;
}
