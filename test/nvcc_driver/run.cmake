cmake_minimum_required(VERSION 3.24)

foreach(argument build config work mode cmake ninja host)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Missing -D${argument}=... for the public SDK fixture")
    endif()
endforeach()
if(NOT mode MATCHES "^(discovery|protocol|execution|archives|cmake|cmake_rdc)$")
    message(FATAL_ERROR "Unknown public SDK profile: ${mode}")
endif()
get_filename_component(work "${work}" ABSOLUTE)
file(MAKE_DIRECTORY "${work}")
file(REAL_PATH "${work}" work)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${work}/${mode}_${nonce}")
get_filename_component(parent "${root}" DIRECTORY)
if(NOT parent STREQUAL work OR root STREQUAL work OR EXISTS "${root}")
    message(FATAL_ERROR "Public SDK deployment must be a new directory inside its owned work area")
endif()
file(MAKE_DIRECTORY "${root}")

# CTest may run outside the developer shell used to configure the build.
if(NOT DEFINED ENV{INCLUDE} OR NOT DEFINED ENV{LIB})
    set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
    execute_process(COMMAND "${vswhere}" -latest -property installationPath
        OUTPUT_VARIABLE visual_studio OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT visual_studio)
        message(FATAL_ERROR "An x64 Visual Studio C++ environment is required")
    endif()
    file(TO_NATIVE_PATH "${visual_studio}/Common7/Tools/VsDevCmd.bat" developer_command)
    file(WRITE "${root}/host_environment.cmd"
        "@echo off\r\ncall \"${developer_command}\" -arch=x64 -host_arch=x64 >nul\r\nif errorlevel 1 exit /b 1\r\nset\r\n")
    execute_process(COMMAND "$ENV{COMSPEC}" /d /c call "${root}/host_environment.cmd"
        OUTPUT_VARIABLE environment COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\r\n" "\n" environment "${environment}")
    while(NOT environment STREQUAL "")
        string(FIND "${environment}" "\n" end)
        if(end LESS 0)
            set(line "${environment}")
            set(environment "")
        else()
            string(SUBSTRING "${environment}" 0 ${end} line)
            math(EXPR next "${end} + 1")
            string(SUBSTRING "${environment}" ${next} -1 environment)
        endif()
        if(line MATCHES "^([^=]+)=(.*)$")
            set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
        endif()
    endwhile()
endif()
foreach(variable CUDA_HOME CUDACXX NVCC_PREPEND_FLAGS NVCC_APPEND_FLAGS CUDAVM_CUDA_DRIVER CUDAVM_DEVICES)
    unset(ENV{${variable}})
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment
    COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "(^|\n)[Cc][Uu][Dd][Aa]_[Pp][Aa][Tt][Hh][^=\n]*=" cuda_paths "${environment}")
foreach(variable IN LISTS cuda_paths)
    string(STRIP "${variable}" variable)
    string(REGEX REPLACE "=$" "" variable "${variable}")
    unset(ENV{${variable}})
endforeach()
set(ENV{CUDAVM_BACKENDS} "")

set(log "${root}/commands.log")
file(WRITE "${log}" "profile=windows-x64-clang-v1\nheader_baseline=13.4.1\nhost_tools=$ENV{VCToolsVersion}\nwindows_sdk=$ENV{WindowsSDKVersion}\n")

function(sdk_run)
    set(command ${ARGV})
    set(failure FALSE)
    if(ARGV0 STREQUAL "FAILURE")
        set(failure TRUE)
        list(REMOVE_AT command 0)
    endif()
    execute_process(COMMAND ${command} WORKING_DIRECTORY "${root}" TIMEOUT 180
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    string(JOIN " " display ${command})
    file(APPEND "${log}" "${display}\n${output}${errors}\n")
    if(status STREQUAL "77" AND "$ENV{CUDAVM_BACKENDS}" STREQUAL "vulkan")
        message(FATAL_ERROR "SKIP: selected Vulkan backend has no available device; evidence: ${root}")
    endif()
    if(NOT status MATCHES "^-?[0-9]+$" OR (failure AND status EQUAL 0) OR (NOT failure AND NOT status EQUAL 0))
        message(FATAL_ERROR "Command returned ${status}: ${display}\n${output}${errors}\nEvidence: ${root}")
    endif()
    set(run_output "${output}${errors}" PARENT_SCOPE)
endfunction()

function(sdk_contains text expected reason)
    string(FIND "${text}" "${expected}" position)
    if(position LESS 0)
        message(FATAL_ERROR "${reason}; missing '${expected}'; evidence: ${root}")
    endif()
endfunction()

function(sdk_equal actual expected reason)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${reason}: '${actual}' != '${expected}'; evidence: ${root}")
    endif()
endfunction()

foreach(tool "${cmake}" "${ninja}" "${host}")
    sdk_run("${tool}" --version)
endforeach()
set(original "${root}/original SDK")
set(sdk "${root}/relocated SDK")
sdk_run("${cmake}" --install "${build}" --config "${config}" --prefix "${original}" --component cuda_sdk)
file(RENAME "${original}" "${sdk}")
if(EXISTS "${original}")
    message(FATAL_ERROR "The original SDK must be unavailable after relocation")
endif()
foreach(name bin/nvcc.exe bin/nvcuda.dll bin/cudart64_13.dll bin/cudavm_core.dll lib/x64/cuda.lib
        lib/x64/cudart.lib lib/x64/cudart_static.lib lib/x64/cudadevrt.lib include/cuda_runtime.h
        include/cuda.h include/crt/host_defines.h version.json)
    if(NOT EXISTS "${sdk}/${name}")
        message(FATAL_ERROR "Missing installed SDK component: ${name}")
    endif()
endforeach()
foreach(pair "cudart/cuda_runtime.h|cuda_runtime.h" "cuda/cuda.h|cuda.h" "nvcc/crt/host_defines.h|crt/host_defines.h")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 module_header)
    list(GET pair 1 public_header)
    file(SHA256 "${sdk}/include/${module_header}" module_hash)
    file(SHA256 "${sdk}/include/${public_header}" public_hash)
    sdk_equal("${module_hash}" "${public_hash}" "Flat public headers retain pinned module bytes")
endforeach()

# Retain ordinary host tools and OS paths, excluding NVIDIA tools and candidate
# source/build tools. Only the relocated SDK supplies CUDA resources.
set(tools "${sdk}/bin")
foreach(tool "${host}" "${cmake}" "${ninja}")
    get_filename_component(directory "${tool}" DIRECTORY)
    list(APPEND tools "${directory}")
endforeach()
string(TOLOWER "$ENV{SystemRoot}" system_root)
set(paths "$ENV{PATH}")
foreach(directory IN LISTS paths)
    string(TOLOWER "${directory}" lower)
    string(FIND "${lower}" "${system_root}" system_prefix)
    if(lower MATCHES "microsoft visual studio|windows kits" OR system_prefix EQUAL 0)
        list(APPEND tools "${directory}")
    endif()
endforeach()
list(REMOVE_DUPLICATES tools)
set(ENV{PATH} "${tools}")
set(nvcc "${sdk}/bin/nvcc.exe")
sdk_run("${nvcc}" --version)
sdk_contains("${run_output}" "release 13.4" "Compiler reports the pinned compatibility baseline")
sdk_contains("${run_output}" "cudavm" "Compiler reports its implementation identity")
sdk_run("${nvcc}" --print-resources)
string(JSON origin GET "${run_output}" origin)
string(JSON public_include GET "${run_output}" public_include)
file(REAL_PATH "${public_include}" public_include)
file(REAL_PATH "${sdk}/include" sdk_include)
sdk_equal("${origin}" "installed-sdk" "Compiler resources belong to the selected SDK")
sdk_equal("${public_include}" "${sdk_include}" "Compiler uses the relocated public include tree")

set(source "${root}/consumer sources")
file(MAKE_DIRECTORY "${source}")
foreach(name launch.cu kernel.cu helper.cu dead.cu device_version.cu main.cpp parameters.hpp)
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/${name}" DESTINATION "${source}")
endforeach()
set(launch "${source}/launch.cu")
function(sdk_gpu executable)
    set(ENV{CUDAVM_BACKENDS} vulkan)
    file(RENAME "${source}" "${root}/unavailable consumer sources")
    sdk_run("${executable}")
    file(RENAME "${root}/unavailable consumer sources" "${source}")
    set(ENV{CUDAVM_BACKENDS} "")
endfunction()

if(mode STREQUAL "discovery")
    set(header "${sdk}/include/cudart/cuda_runtime.h")
    file(RENAME "${header}" "${header}.saved")
    sdk_run(FAILURE "${nvcc}" -c "${launch}" -o "${root}/missing.obj")
    sdk_contains("${run_output}" "installed SDK public header is unavailable" "Missing selected resources cannot fall back to another toolkit")
    file(RENAME "${header}.saved" "${header}")
elseif(mode STREQUAL "protocol")
    set(object "${root}/compiled object.obj")
    set(depfile "${root}/dependencies.d")
    set(response "${root}/compile options.rsp")
    string(ASCII 239 187 191 bom)
    file(WRITE "${response}" "${bom}-c -O1 -std=c++17 -DFIXTURE_FACTOR=5 \"-I${source}\" -MMD -MF \"${depfile}\" \"${launch}\" -o \"${object}\"\n")
    sdk_run("${nvcc}" "@${response}")
    file(READ "${object}" magic LIMIT 2 HEX)
    sdk_equal("${magic}" "6486" "Compiler produces ordinary x64 COFF")
    file(READ "${depfile}" dependencies)
    sdk_contains("${dependencies}" "parameters.hpp" "Depfile tracks real user headers")
    sdk_contains("${dependencies}" "compiled" "Depfile names the public output")
    if(dependencies MATCHES "\\.nvcc-")
        message(FATAL_ERROR "Temporary compiler paths leaked into the public depfile")
    endif()
    set(executable "${sdk}/bin/cpu.exe")
    sdk_run("${nvcc}" "${object}" -o "${executable}")
    sdk_run("${executable}" cpu)
    sdk_run("${nvcc}" -E -DFIXTURE_FACTOR=11 -UFIXTURE_FACTOR -DFIXTURE_FACTOR=5 "${launch}")
    sdk_contains("${run_output}" "fixture_factor = 5" "Preprocessing preserves command-line macro order")
    sdk_run("${nvcc}" -MM "${launch}")
    sdk_contains("${run_output}" "parameters.hpp" "Dependency-only compilation follows user headers")
    file(SHA256 "${object}" before)
    file(WRITE "${source}/broken.cu" "__global__ void broken( {\n")
    sdk_run(FAILURE "${nvcc}" -c "${source}/broken.cu" -o "${object}")
    file(SHA256 "${object}" after)
    sdk_equal("${before}" "${after}" "Failed compilation preserves previous valid output")
    sdk_run(FAILURE "${nvcc}" --not-a-supported-option -c "${launch}" -o "${object}")
    sdk_run(FAILURE "${nvcc}" --forward-unknown-to-host-compiler --not-a-host-option -c "${launch}" -o "${object}")
    sdk_run("${nvcc}" -c "${launch}" -o "${object}")
    sdk_run("${nvcc}" -ptx "${launch}" -o "${root}/program.ptx")
    file(READ "${root}/program.ptx" ptx)
    sdk_contains("${ptx}" ".version" "Public text output retains PTX representation")
    sdk_run("${nvcc}" -cubin "${launch}" -o "${root}/program.cubin")
    string(HEX "CUDAVM-PROGRAM-IMAGE\n" expected_magic)
    file(READ "${root}/program.cubin" magic LIMIT 21 HEX)
    sdk_equal("${magic}" "${expected_magic}" "Public binary output uses the portable image representation")
elseif(mode STREQUAL "execution")
    foreach(linkage static shared)
        set(executable "${sdk}/bin/${linkage}.exe")
        sdk_run("${nvcc}" -std=c++17 -O2 -DFIXTURE_FACTOR=11 -UFIXTURE_FACTOR -DFIXTURE_FACTOR=5
            "--cudart=${linkage}" "${launch}" -o "${executable}")
        sdk_run("${executable}" cpu)
        sdk_gpu("${executable}")
    endforeach()
    sdk_run("${nvcc}" -rdc=true "${source}/device_version.cu" -o "${sdk}/bin/device_version.exe")
    sdk_gpu("${sdk}/bin/device_version.exe")
elseif(mode STREQUAL "archives")
    set(objects)
    foreach(unit kernel helper dead)
        set(object "${root}/${unit}.obj")
        sdk_run("${nvcc}" -dc -O1 "${source}/${unit}.cu" -o "${object}")
        list(APPEND objects "${object}")
    endforeach()
    set(main_object "${root}/main.obj")
    set(archive "${root}/device.lib")
    sdk_run("${nvcc}" -c "${source}/main.cpp" -o "${main_object}")
    sdk_run("${nvcc}" -lib ${objects} -o "${archive}")
    sdk_run("${nvcc}" "${main_object}" "${archive}" -o "${sdk}/bin/implicit.exe")
    sdk_gpu("${sdk}/bin/implicit.exe")
    set(dlink "${root}/dlink.obj")
    sdk_run("${nvcc}" -dlink "${main_object}" "${archive}" -o "${dlink}")
    sdk_run("${host}" /nologo /MT "${main_object}" "${archive}" "${dlink}"
        "/Fe${sdk}/bin/ordinary_link.exe" /link "/LIBPATH:${sdk}/lib/x64" cudart_static.lib cuda.lib)
    sdk_gpu("${sdk}/bin/ordinary_link.exe")
    file(SHA256 "${dlink}" before)
    list(GET objects 0 kernel_object)
    sdk_run(FAILURE "${nvcc}" -dlink "${kernel_object}" -o "${dlink}")
    file(SHA256 "${dlink}" after)
    sdk_equal("${before}" "${after}" "Failed device link preserves completed output")
else()
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/../cuda_build_integration/CMakeLists.txt" DESTINATION "${source}")
    set(consumer_build "${root}/consumer build")
    set(rdc OFF)
    if(mode STREQUAL "cmake_rdc")
        set(rdc ON)
    endif()
    sdk_run("${cmake}" -S "${source}" -B "${consumer_build}" -G Ninja "-DCMAKE_MAKE_PROGRAM=${ninja}"
        "-DCMAKE_CXX_COMPILER=${host}" "-DCMAKE_CUDA_COMPILER=${nvcc}" "-DCMAKE_CUDA_HOST_COMPILER=${host}"
        "-DCUDAToolkit_ROOT=${sdk}" -DCMAKE_CUDA_ARCHITECTURES=75 -DCMAKE_CUDA_STANDARD=17
        -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${sdk}/bin" "-DFIXTURE_RDC=${rdc}")
    sdk_run("${cmake}" --build "${consumer_build}" --parallel 2)
    sdk_gpu("${sdk}/bin/cuda_stock.exe")
    sdk_run("${cmake}" --build "${consumer_build}" --parallel 2)
    if(mode STREQUAL "cmake")
        file(APPEND "${source}/parameters.hpp" "\nstatic_assert(fixture_bias == 7);\n")
        sdk_run("${cmake}" --build "${consumer_build}" --parallel 2)
        sdk_contains("${run_output}" "Building CUDA object" "Stock incremental builds follow CUDA header dependencies")
        sdk_gpu("${sdk}/bin/cuda_stock.exe")
    endif()
endif()

file(COPY_FILE "${log}" "${work}/${mode}.log")
file(REAL_PATH "${root}" resolved_root)
cmake_path(IS_PREFIX work "${resolved_root}" NORMALIZE owned)
if(NOT owned OR resolved_root STREQUAL work OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "Refusing cleanup outside the owned public SDK deployment")
endif()
file(REMOVE_RECURSE "${resolved_root}")
message(STATUS "PASS: installed public SDK ${mode}")
