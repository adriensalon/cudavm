.version 6.5
.target sm_75
.address_size 64
.extern .shared .align 16 .b8 dynamic_values[];

.visible .entry dynamic_reduce(.param .u64 out, .param .u64 in, .param .u32 count) {
 .reg .b64 %out, %in, %shared, %own, %other;
 .reg .b32 %lane, %lanes, %block, %index, %count, %value, %peer, %step, %rhs;
 .reg .pred %valid, %active, %more;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in]; ld.param.u32 %count,[count];
 mov.u32 %lane,%tid.x; mov.u32 %lanes,%ntid.x; mov.u32 %block,%ctaid.x;
 mad.lo.u32 %index,%block,%lanes,%lane; setp.lt.u32 %valid,%index,%count;
 mov.u32 %value,0; @!%valid bra initialized;
 mad.wide.u32 %in,%index,4,%in; ld.global.u32 %value,[%in];
initialized:
 mov.u64 %shared,dynamic_values; mad.wide.u32 %own,%lane,4,%shared;
 st.shared.u32 [%own],%value; bar.sync 0;
 shr.u32 %step,%lanes,1;
loop:
 setp.ne.u32 %more,%step,0; @!%more bra done;
 setp.lt.u32 %active,%lane,%step; @!%active bra rendezvous;
 add.u32 %peer,%lane,%step; mad.wide.u32 %other,%peer,4,%shared;
 ld.shared.u32 %value,[%own]; ld.shared.u32 %rhs,[%other];
 add.u32 %value,%value,%rhs; st.shared.u32 [%own],%value;
rendezvous:
 bar.sync 0; shr.u32 %step,%step,1; bra loop;
done:
 setp.eq.u32 %active,%lane,0; @!%active ret;
 ld.shared.u32 %value,[%own]; mad.wide.u32 %out,%block,4,%out;
 st.global.u32 [%out],%value; ret;
}

.visible .entry mixed_exchange(.param .u64 out, .param .u64 in, .param .u32 count) {
 .shared .align 4 .b8 fixed[12];
 .reg .b64 %out, %in, %shared, %address, %fixed;
 .reg .b32 %lane, %lanes, %block, %index, %count, %value, %peer, %bias;
 .reg .pred %valid, %first;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in]; ld.param.u32 %count,[count];
 mov.u32 %lane,%tid.x; mov.u32 %lanes,%ntid.x; mov.u32 %block,%ctaid.x;
 mad.lo.u32 %index,%block,%lanes,%lane;
 mov.u64 %fixed,fixed; setp.eq.u32 %first,%lane,0;
 add.u32 %bias,%block,7; @%first st.shared.u32 [%fixed+8],%bias;
 mov.u32 %value,0; setp.lt.u32 %valid,%index,%count; @!%valid bra initialized;
 mad.wide.u32 %in,%index,4,%in; ld.global.u32 %value,[%in];
initialized:
 mov.u64 %shared,dynamic_values; mad.wide.u32 %address,%lane,4,%shared;
 st.shared.u32 [%address],%value; bar.sync 0;
 sub.u32 %peer,%lanes,%lane; sub.u32 %peer,%peer,1;
 mad.wide.u32 %address,%peer,4,%shared; ld.shared.u32 %value,[%address];
 ld.shared.u32 %bias,[%fixed+8]; add.u32 %value,%value,%bias;
 @!%valid ret;
 mad.wide.u32 %out,%index,4,%out; st.global.u32 [%out],%value; ret;
}
