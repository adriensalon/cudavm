// Independently authored PTX: typed loads/stores and exact representation moves.
.version 6.5
.target sm_75
.address_size 64
.visible .entry numeric_bits(.param .u64 out, .param .u64 in, .param .u32 count) {
 .reg .b64 %out,%in,%wide,%other;
 .reg .b32 %i,%block,%threads,%count,%a,%b,%lo,%hi;
 .reg .f32 %fa,%fb;
 .reg .f64 %real;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %out,[out]; ld.param.u64 %in,[in];
 mad.wide.u32 %out,%i,48,%out; mad.wide.u32 %in,%i,16,%in;
 ld.global.f32 %fa,[%in]; ld.global.f32 %fb,[%in+4];
 mov.b32 %a,%fa; mov.b32 %b,%fb;
 st.global.u32 [%out],%a; st.global.u32 [%out+4],%b;
 ld.global.u32 %a,[%in]; ld.global.s32 %b,[%in+4];
 mov.b32 %fa,%a; mov.b32 %fb,%b;
 st.global.f32 [%out+8],%fa; st.global.f32 [%out+12],%fb;
 ld.global.b64 %wide,[%in+8]; mov.b64 %real,%wide; st.global.f64 [%out+16],%real;
 ld.global.f64 %real,[%in+8]; mov.b64 %other,%real; st.global.b64 [%out+24],%other;
 mov.b64 {%lo,%hi},%real; st.global.u32 [%out+32],%lo; st.global.u32 [%out+36],%hi;
 mov.b64 %real,{%b,%a}; st.global.f64 [%out+40],%real;
 ret;
}
