// Independently authored PTX; arithmetic is unsigned modulo 2^32.
.version 6.5
.target sm_75
.address_size 64
.visible .entry branch_loop(.param .u64 out, .param .u64 in, .param .u32 count, .param .u32 seed) {
 .reg .b64 %a,%b;
 .reg .b32 %i,%block,%threads,%count,%value,%seed,%state,%step,%limit,%stop,%t,%selector;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %b,[in]; mad.wide.u32 %b,%i,4,%b; ld.global.u32 %value,[%b];
 setp.eq.u32 %p,%value,0; @%p ret;
 ld.param.u32 %seed,[seed]; xor.b32 %state,%value,%seed;
 and.b32 %limit,%value,7; shr.u32 %stop,%value,5; and.b32 %stop,%stop,7;
 mov.u32 %step,0;
loop:
 setp.ge.u32 %p,%step,%limit; @%p bra finish;
 setp.eq.u32 %p,%step,%stop; @%p bra finish;
 and.b32 %t,%step,1; setp.ne.u32 %p,%t,0; @%p bra odd;
 mad.lo.u32 %state,%state,3,%step; bra next;
odd:
 shr.u32 %state,%state,1; add.u32 %t,%value,%step; xor.b32 %state,%state,%t;
next:
 and.b32 %t,%state,3; setp.ne.u32 %p,%t,0; @%p bra mix;
 add.u32 %state,%state,17; bra increment;
mix:
 xor.b32 %state,%state,0x9e3779b9;
increment:
 add.u32 %step,%step,1; bra loop;
finish:
 shr.u32 %selector,%value,3; and.b32 %selector,%selector,3;
 setp.eq.u32 %p,%selector,0; @%p bra add_seed;
 setp.eq.u32 %p,%selector,1; @%p bra xor_seed;
 setp.eq.u32 %p,%selector,2; @%p bra rotate;
 not.b32 %state,%state; bra write;
add_seed:
 add.u32 %state,%state,%seed; bra write;
xor_seed:
 xor.b32 %state,%state,%seed; bra write;
rotate:
 shr.u32 %t,%state,29; shl.b32 %state,%state,3; or.b32 %state,%state,%t;
write:
 ld.param.u64 %a,[out]; mad.wide.u32 %a,%i,8,%a;
 st.global.u32 [%a],%state; st.global.u32 [%a+4],%step; ret;
}
