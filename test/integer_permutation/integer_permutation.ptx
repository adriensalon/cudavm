// Independently authored PTX; __byte_perm ignores each selector nibble's high bit.
.version 6.5
.target sm_75
.address_size 64
.visible .entry permute_bytes(.param .u64 out, .param .u64 in, .param .u32 count) {
 .reg .b64 %a,%b;
 .reg .b32 %i,%block,%threads,%count,%low,%high,%selector,%masked,%bytes,%raw;
 .reg .pred %p;
 mov.u32 %i,%tid.x; mov.u32 %block,%ctaid.x; mov.u32 %threads,%ntid.x;
 mad.lo.u32 %i,%block,%threads,%i;
 ld.param.u32 %count,[count]; setp.ge.u32 %p,%i,%count; @%p ret;
 ld.param.u64 %a,[out]; ld.param.u64 %b,[in];
 mad.wide.u32 %a,%i,8,%a; mad.wide.u32 %b,%i,12,%b;
 ld.global.u32 %low,[%b]; ld.global.u32 %high,[%b+4]; ld.global.u32 %selector,[%b+8];
 and.b32 %masked,%selector,0x7777;
 prmt.b32 %bytes,%low,%high,%masked; prmt.b32 %raw,%low,%high,%selector;
 st.global.u32 [%a],%bytes; st.global.u32 [%a+4],%raw; ret;
}
